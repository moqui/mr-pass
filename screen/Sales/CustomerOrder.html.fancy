<#if failure><h1>${ec.l10n.localize("Your order")}</h1><p role="alert" class="error">${failure.message}</p><#if failure.kind == 'AuthenticationRequired'><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath + '?' + orderQuery)}">${ec.l10n.localize("Sign in")}</a></p></#if>
<#else><#assign o = view.order><h1>${ec.resource.expand("Order ${o.orderId}", "", {o: o})}<#if o.name> · ${o.name}</#if></h1>
<#if flash.error><p role="alert" class="error">${flash.error}</p></#if>
<section class="card" id="OrderSummary"><p role="status"><strong>${o.stateText}</strong><#if o.cancelled> ${ec.l10n.localize("· this order was cancelled and can no longer be changed")}</#if></p><dl><dt>${ec.l10n.localize("From")}</dt><dd>${o.sellerName}<#if o.repName> · ${o.repName}</#if></dd><dt>${ec.l10n.localize("For customer")}</dt><dd>${o.customerName}</dd><dt>${ec.l10n.localize("Placed")}</dt><dd>${o.placedText}</dd><#if o.purchaseOrder><dt>${ec.l10n.localize("Your purchase order")}</dt><dd>${o.purchaseOrder}</dd></#if><#if o.shipByText><dt>${ec.l10n.localize("Ships by")}</dt><dd>${o.shipByText}</dd></#if><#if o.deliveryByText><dt>${ec.l10n.localize("Delivery by")}</dt><dd>${o.deliveryByText}</dd></#if>
<#if view.acceptedQuote><dt>${ec.l10n.localize("From quote")}</dt><dd><#if view.capabilities.quoteLink><a href="${passBases.sales}/CustomerQuote?orderId=${encodeURIComponent(view.acceptedQuote.orderId)}">${ec.resource.expand("Quote ${view.acceptedQuote.orderId}", "", {view: view})}</a><#else>${ec.resource.expand("Quote ${view.acceptedQuote.orderId}", "", {view: view})}</#if>${ec.resource.expand(", revision ${view.acceptedQuote.revision}, accepted ${view.acceptedQuote.acceptedText}", "", {view: view})}</dd></#if></dl>
<div class="table-wrap"><table class="lines"><thead><tr><th scope="col">${ec.l10n.localize("Item")}</th><th scope="col">${ec.l10n.localize("Quantity")}</th><th scope="col">${ec.l10n.localize("Price")}</th><th scope="col">${ec.l10n.localize("Amount")}</th></tr></thead><tbody>
<#list o.lines as l><tr><td class="wrap">${l.productText}<#if l.description><br><small>${l.description}</small></#if><#if l.promisedText><br><small>${ec.resource.expand("Needed by ${l.promisedText}", "", {l: l})}</small></#if></td><td>${l.quantityText}</td><td>${l.priceText}</td><td>${l.amountText}</td></tr></#list></tbody></table></div>
<dl><dt>${ec.l10n.localize("Products")}</dt><dd>${o.productsText}</dd><#if o.shippingText><dt>${ec.l10n.localize("Shipping")}</dt><dd>${o.shippingText}</dd></#if><#if o.taxText><dt>${ec.l10n.localize("Tax")}</dt><dd>${o.taxText}</dd></#if><dt>${ec.l10n.localize("Total")}</dt><dd><strong>${o.totalText}</strong> ${o.currencyUomId}</dd></dl>
<#if view.document><p><a href="${publicPath}/document?${orderQuery}" id="OrderDocument">${ec.resource.expand("Download the order confirmation (PDF): ${view.document.fileName}", "", {view: view})}</a></p></#if></section>
<section class="card" id="OrderShipments"><h2>${ec.l10n.localize("Delivery")}</h2><#if !view.shipments.length><p>${ec.l10n.localize("Nothing has shipped yet.")}</p></#if><#list view.shipments as s><article><p><strong>${s.statusText}</strong><#if s.shippedText> ${ec.resource.expand("· shipped ${s.shippedText}", "", {s: s})}</#if><#if s.arrivalText> ${ec.resource.expand("· expected ${s.arrivalText}", "", {s: s})}</#if><#if s.carrierText> · ${s.carrierText}</#if></p><#if s.tracking.length><p>${ec.l10n.localize("Tracking")} <#list s.tracking as t><#if t.url><a href="${t.url}" rel="noopener noreferrer" target="_blank">${t.code}</a><#else>${t.code}</#if> </#list></p></#if><#if s.items.length><ul><#list s.items as i><li>${i.productText} × ${i.quantityText}</li></#list></ul></#if></article></#list></section>
<section class="card" id="OrderInvoices"><h2>${ec.l10n.localize("Invoices")}</h2><#if !view.invoices.length><p>${ec.l10n.localize("No invoice yet.")}</p></#if><#list view.invoices as i><article><p><strong>${ec.resource.expand("Invoice ${i.invoiceId}", "", {i: i})}</strong> · ${i.invoiceDateText}<#if i.dueText>${ec.resource.expand(" · due ${i.dueText}", "", {i: i})}</#if> · ${i.totalText}</p><p><#if i.paid>${ec.l10n.localize("Paid")}<#else>${ec.resource.expand("Open: ${i.openText}", "", {i: i})}</#if><#if i.billingUrl> · <a href="${i.billingUrl}">${ec.l10n.localize("Open in Billing")}</a></#if></p></article></#list></section>
<#assign a = view.actions><#if a.askUrl || a.requestCancelUrl || a.requestReturnUrl || a.cancellationRequested><nav class="card" id="OrderHelp" aria-label="${ec.l10n.localize("Help with this order")}"><h2>${ec.l10n.localize("Help with this order")}</h2><p><#if a.askUrl><a href="${a.askUrl}"><#if o.cancelled>${ec.l10n.localize("Ask about this order")}<#else>${ec.l10n.localize("Ask about or change this order")}</#if></a></#if><#if a.requestCancelUrl> · <a href="${a.requestCancelUrl}">${ec.l10n.localize("Request cancellation")}</a></#if><#if a.requestReturnUrl> · <a href="${a.requestReturnUrl}">${ec.l10n.localize("Request a return")}</a></#if><#if a.cancellationRequested> · <strong>${ec.l10n.localize("Cancellation requested")}</strong></#if></p></nav></#if>
<p>${ec.resource.expand("Questions? Contact ${o.repName || o.sellerName}.", "", {o: o})}</p></#if>
