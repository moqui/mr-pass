<h1>${ec.l10n.localize("My quotes")}</h1>
<#if !siteInfo.authenticated><p>${ec.l10n.localize("Sign in to see the quotes we sent your company. A quote's link in our email opens it without signing in.")}</p><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath || '')}">${ec.l10n.localize("Sign in")}</a></p>
<#elseif failure><p role="alert" class="error">${failure.message}</p>
<#else><form method="get" id="MyQuoteFind" class="card" role="search" action="${publicPath}"><label>${ec.l10n.localize("Show")} <select name="state"><option value="all"<#if state == 'all'> selected</#if>>${ec.l10n.localize("All")}</option><option value="open"<#if state == 'open'> selected</#if>>${ec.l10n.localize("Open")}</option></select></label><button>${ec.l10n.localize("Find")}</button></form>
<section id="MyQuotes" aria-label="${ec.l10n.localize("Quotes")}"><#if !view.actingFor><p class="card">${ec.l10n.localize("Your account is not a contact of a customer here. Ask your sales contact for an invitation.")}</p><#elseif !view.quoteList.length><p class="card">${ec.l10n.localize("No quotes to show.")}</p></#if>
<#list view.quoteList as row><article class="card"><h2><a href="${passBases.sales}/CustomerQuote?orderId=${encodeURIComponent(row.orderId)}">${ec.resource.expand("Quote ${row.orderId}", "", {row: row})}<#if row.name> · ${row.name}</#if></a></h2><p><strong>${row.stateText}</strong> · ${row.totalText}</p><p><small><#if row.customerName>${row.customerName} · </#if>${ec.resource.expand("issued ${row.issuedText}", "", {row: row})}<#if row.validThruText>${ec.resource.expand(" · valid through ${row.validThruText}", "", {row: row})}</#if></small></p></article></#list></section>
<#if nextHref || firstHref><nav class="card" aria-label="${ec.l10n.localize("More quotes")}"><#if firstHref><a href="${firstHref}">${ec.l10n.localize("Newest quotes")}</a> </#if><#if nextHref><a href="${nextHref}" id="MyQuotesMore">${ec.l10n.localize("Older quotes")}</a></#if></nav></#if></#if>
