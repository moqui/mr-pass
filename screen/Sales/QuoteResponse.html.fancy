<#if failure><h1>${ec.l10n.localize("Your response")}</h1><p role="alert" class="error">${failure.message}</p><#if failure.kind == 'AuthenticationRequired'><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath + '?' + quoteQuery)}">${ec.l10n.localize("Sign in")}</a></p></#if>
<#else><#assign q = view.quote><#assign r = view.response><h1>${r.accepted ? ec.l10n.localize("Quote accepted") : ec.l10n.localize("Quote declined")}</h1>
<#if flash.notice><p role="status" class="card">${flash.notice}</p></#if>
<section class="card" id="ResponseReceipt" aria-live="polite"><p><strong>${r.message}</strong></p><dl><dt>${ec.l10n.localize("Quote")}</dt><dd>${q.orderId}<#if q.name> · ${q.name}</#if>${ec.resource.expand(", revision ${q.revision}", "", {q: q})}</dd><dt>${ec.l10n.localize("From")}</dt><dd>${q.sellerName}</dd><dt>${ec.l10n.localize("For customer")}</dt><dd>${q.customerName}</dd><#if q.totalText><dt>${ec.l10n.localize("Total")}</dt><dd>${q.totalText} ${q.currencyUomId}</dd></#if><dt>${r.responseText}</dt><dd>${r.respondedText} · ${r.byText}</dd>
<#if r.acceptorName><dt>${ec.l10n.localize("By")}</dt><dd>${r.acceptorName}<#if r.acceptorTitle>, ${r.acceptorTitle}</#if></dd></#if><#if r.purchaseOrder><dt>${ec.l10n.localize("Your purchase order")}</dt><dd>${r.purchaseOrder}</dd></#if><#if r.orderId><dt>${ec.l10n.localize("Order")}</dt><dd><#if token>${r.orderId}<#else><a href="${passBases.sales}/CustomerOrder?orderId=${encodeURIComponent(r.orderId)}" id="ReceiptOrder">${r.orderId}</a></#if></dd></#if><#if r.reason><dt>${ec.l10n.localize("Your reason")}</dt><dd class="wrap">${r.reason}</dd></#if></dl>
<#if view.document><p><a href="${passBases.sales}/CustomerQuote/document?${quoteQuery}">${ec.resource.expand("Download the quote (PDF): ${view.document.fileName}", "", {view: view})}</a></p></#if>
<p>${ec.resource.expand("Questions? Contact ${q.repName || q.sellerName}.", "", {q: q})}</p></section></#if>
