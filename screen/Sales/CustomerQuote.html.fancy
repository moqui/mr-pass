<#if failure><h1>${ec.l10n.localize("Your quote")}</h1><p role="alert" class="error">${failure.message}</p><#if failure.kind == 'AuthenticationRequired'><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath + '?' + quoteQuery)}">${ec.l10n.localize("Sign in")}</a></p></#if>
<#else><#assign q = view.quote><h1>${ec.resource.expand("Quote ${q.orderId}", "", {q: q})}<#if q.name> · ${q.name}</#if></h1>
<#if flash.notice><p role="status" class="card">${flash.notice}</p></#if><#if flash.error><p role="alert" class="error" id="QuoteError">${flash.error}</p><#if flash.reason == 'acceptanceSignInRequired' || flash.reason == 'signInRequired'><p><a href="${signInHref}">${ec.l10n.localize("Sign in")}</a></p></#if></#if>
<section class="card" id="QuoteOffer"><p><strong>${q.stateText}</strong></p><dl><dt>${ec.l10n.localize("From")}</dt><dd>${q.sellerName}<#if q.repName> · ${q.repName}</#if></dd><dt>${ec.l10n.localize("For customer")}</dt><dd>${q.customerName}</dd><dt>${ec.l10n.localize("Revision")}</dt><dd>${q.revision}</dd><dt>${ec.l10n.localize("Issued on")}</dt><dd>${q.issuedText}</dd><dt>${ec.l10n.localize("Valid through")}</dt><dd>${q.validThruText}</dd><#if q.yourReference><dt>${ec.l10n.localize("Your reference")}</dt><dd>${q.yourReference}</dd></#if></dl>
<#if q.changedSinceAccepted><p class="card" id="QuoteChanged">${ec.l10n.localize("The order has changed since you accepted this quote. The PDF below is the quote as we offered it")}<#if token>${ec.l10n.localize("; the order's own page shows what is ordered now (its link is in our order confirmation)")}<#else>; <a href="${passBases.sales}/CustomerOrder?orderId=${encodeURIComponent(q.orderId)}">${ec.l10n.localize("see the order")}</a> ${ec.l10n.localize("for what is ordered now")}</#if>.</p><#else><div class="table-wrap"><table class="lines"><thead><tr><th scope="col">${ec.l10n.localize("Item")}</th><th scope="col">${ec.l10n.localize("Quantity")}</th><th scope="col">${ec.l10n.localize("Price")}</th><th scope="col">${ec.l10n.localize("Amount")}</th></tr></thead><tbody>
<#list q.lines as l><tr><td class="wrap">${l.productText}<#if l.description><br><small>${l.description}</small></#if></td><td>${l.quantityText}</td><td>${l.priceText}</td><td>${l.amountText}</td></tr></#list></tbody></table></div>
<dl><dt>${ec.l10n.localize("Products")}</dt><dd>${q.productsText}</dd><#if q.shippingText><dt>${ec.l10n.localize("Shipping")}</dt><dd>${q.shippingText}</dd></#if><#if q.taxText><dt>${ec.l10n.localize("Tax")}</dt><dd>${q.taxText}</dd></#if><dt>${ec.l10n.localize("Total")}</dt><dd><strong>${q.totalText}</strong> ${q.currencyUomId}</dd></dl></#if>
<#if view.document><p><a href="${publicPath}/document?${quoteQuery}" id="QuoteDocument">${ec.resource.expand("Download the quote (PDF): ${view.document.fileName}", "", {view: view})}</a></p></#if>
<#if q.termsText><h2>${ec.l10n.localize("Terms")}</h2><p class="wrap">${q.termsText}</p></#if></section>
<#if view.response><section class="card" id="QuoteAnswered"><h2>${view.response.responseText}</h2><p>${view.response.message}</p><p><a href="${passBases.sales}/QuoteResponse?${quoteQuery}">${ec.l10n.localize("See the receipt")}</a></p></section></#if>
<#if view.capabilities.signInToAccept><section class="card" id="QuoteSignIn"><h2>${ec.l10n.localize("Accept this quote")}</h2><p>${ec.resource.expand("To accept a quote of this amount, sign in as a contact invited for ${q.customerName}. You can still decline it here.", "", {q: q})}</p><p><a href="${signInHref}">${ec.l10n.localize("Sign in to accept")}</a></p></section></#if>
<#if view.capabilities.canAccept><form method="post" id="AcceptQuote" class="card" action="${publicPath}/respond"><h2>${ec.l10n.localize("Accept this quote")}</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="operationId" value="${respondOperationId}"><input type="hidden" name="action" value="accept"><input type="hidden" name="expectedRevision" value="${q.revision}"><#if token><input type="hidden" name="token" value="${token}"><#else><input type="hidden" name="orderId" value="${q.orderId}"></#if>
<p>${ec.resource.expand("You accept the whole quote ${q.orderId}, revision ${q.revision}, for", "", {q: q})} <strong>${q.totalText}</strong> ${q.currencyUomId}. ${ec.resource.expand("The offer cannot be changed here; to change it, ask ${q.repName || q.sellerName} for a new quote.", "", {q: q})}</p>
<label>${ec.l10n.localize("Your purchase order number")}<#if view.capabilities.poRequired> <span aria-hidden="true">*</span></#if> <input name="purchaseOrder" maxlength="60"<#if view.capabilities.poRequired> required</#if>></label>
<label>${ec.l10n.localize("Your name")} <input name="acceptorName" maxlength="120" required autocomplete="name"></label><label>${ec.l10n.localize("Your title")} <input name="acceptorTitle" maxlength="120" autocomplete="organization-title"></label>
<label><input type="checkbox" name="acknowledge" value="Y" required> ${ec.resource.expand("I accept this quote and its terms for ${q.customerName}", "", {q: q})}</label><p><button>${ec.l10n.localize("Accept the quote")}</button></p></form></#if>
<#if view.capabilities.canDecline><form method="post" id="DeclineQuote" class="card" action="${publicPath}/respond"><h2>${ec.l10n.localize("Decline this quote")}</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="operationId" value="${declineOperationId}"><input type="hidden" name="action" value="decline"><#if token><input type="hidden" name="token" value="${token}"><#else><input type="hidden" name="orderId" value="${q.orderId}"></#if>
<label>${ec.l10n.localize("Why (so we can do better)")} <textarea name="reason" rows="3" maxlength="2000" required></textarea></label><p><button>${ec.l10n.localize("Decline the quote")}</button></p></form></#if></#if>
