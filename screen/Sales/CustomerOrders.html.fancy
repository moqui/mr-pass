<h1>${ec.l10n.localize("My orders")}</h1>
<#if !siteInfo.authenticated><p>${ec.l10n.localize("Sign in to see your company's orders with us. The link in our order confirmation opens that order without signing in.")}</p><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath || '')}">${ec.l10n.localize("Sign in")}</a></p>
<#elseif failure><p role="alert" class="error">${failure.message}</p>
<#else><form method="get" id="MyOrderFind" class="card" role="search" action="${publicPath}"><label>${ec.l10n.localize("Show")} <select name="state"><option value="all"<#if state == 'all'> selected</#if>>${ec.l10n.localize("All")}</option><option value="open"<#if state == 'open'> selected</#if>>${ec.l10n.localize("Open")}</option></select></label> <label>${ec.l10n.localize("Order or your PO")} <input name="reference" maxlength="60" value="${reference}"></label><button>${ec.l10n.localize("Find")}</button></form>
<section id="MyOrders" aria-label="${ec.l10n.localize("Orders")}"><#if !view.actingFor><p class="card">${ec.l10n.localize("Your account is not a contact of a customer here. Ask your sales contact for an invitation.")}</p><#elseif !view.orderList.length><p class="card">${ec.l10n.localize("No orders to show.")}</p></#if>
<#list view.orderList as row><article class="card"><h2><a href="${passBases.sales}/CustomerOrder?orderId=${encodeURIComponent(row.orderId)}">${ec.resource.expand("Order ${row.orderId}", "", {row: row})}<#if row.name> · ${row.name}</#if></a></h2><p><strong>${row.stateText}</strong> · ${row.totalText}</p><p><small><#if row.customerName>${row.customerName} · </#if>${ec.resource.expand("placed ${row.placedText}", "", {row: row})}<#if row.purchaseOrder>${ec.resource.expand(" · your PO ${row.purchaseOrder}", "", {row: row})}</#if></small></p><p><small>${row.deliveryText} · ${row.billingText}</small></p></article></#list></section>
<#if nextHref || firstHref><nav class="card" aria-label="${ec.l10n.localize("More orders")}"><#if firstHref><a href="${firstHref}">${ec.l10n.localize("Newest orders")}</a> </#if><#if nextHref><a href="${nextHref}" id="MyOrdersMore">${ec.l10n.localize("Older orders")}</a></#if></nav></#if></#if>
