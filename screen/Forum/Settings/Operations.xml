<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" require-authentication="false" default-menu-title="Operations">
  <transition name="downloadExport" method="get" read-only="true">
    <actions>
      <script>ec.resource.script('component://mr-pass/service/pass/Facade.js').downloadExport(resolvedSiteId,ec.web.parameters.exportId)</script>
    </actions>
    <default-response type="none"/>
  </transition>
  <transition name="save">
    <actions>
      <script><![CDATA[
        const saved=ec.resource.script('component://mr-pass/screen/Shared/View.js').save('Operations',resolvedSiteId,ec.web.parameters)
        if(ec.web.parameters.formAction==='previewOperation' && ec.web.response){ec.web.response.setContentType('text/html');ec.web.response.write(ec.resource.script('component://mr-pass/screen/Shared/View.js').operationPreview(saved,publicPath.replace(/\/save$/, '')));return}
        if(ec.web.parameters.formAction?.startsWith('preview') && ec.web.response){ec.web.response.setContentType('text/html');ec.web.response.write(ec.resource.script('component://mr-pass/screen/Shared/View.js').preview(saved,publicPath.replace(/\/save$/, '')));return}
        if (ec.web.request.getHeader('accept')?.includes('application/json')) ec.web.sendJsonResponse(saved)
        else ec.web.response.sendRedirect(publicPath.replace(/\/save$/, '') + '?saved=true')
    ]]></script>
    </actions>
    <default-response type="none"/>
  </transition>
  <actions>
    <script><![CDATA[
        screenName='Operations'
        view=ec.resource.script('component://mr-pass/screen/Shared/View.js').load(screenName,siteId,ec.web.parameters,passBases,siteInfo)
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Shared/Page.html.fancy"/>
    </render-mode>
    <section name="PassOperationsManageRunSection" condition="view.forms.some(form =&gt; form.op === 'manageRun')">
      <widgets>
        <render-mode>
          <text type="html"><![CDATA[<form method="post" id="PassOperationsManageRun" action="${publicPath}/save"><h2>Recover a checkpointed job</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">]]></text>
        </render-mode>
        <form-single name="PassOperationsManageRun" transition="save" map="Object.assign({},view.formValues['manageRun'] || {},ec.web.parameters)" skip-start="true" skip-end="true">
          <field name="formAction">
            <default-field>
              <hidden default-value="manageRun"/>
            </default-field>
          </field>
          <field name="operationId">
            <default-field>
              <hidden default-value="${ec.user.randomString(32)}"/>
            </default-field>
          </field>
          <field name="rootCommEventId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="contactListId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="reviewId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="token">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="returnTo">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeType">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="runId">
            <default-field title="Run">
              <text-line input-type="text"/>
            </default-field>
          </field>
          <field name="action">
            <default-field title="Action">
              <drop-down allow-empty="false">
                <option key="retry" text="retry"/>
                <option key="cancel" text="cancel"/>
                <option key="resume" text="resume"/>
              </drop-down>
            </default-field>
          </field>
          <field name="reason">
            <default-field title="Reason">
              <text-line input-type="text"/>
            </default-field>
          </field>
          <field name="submitAction">
            <default-field title="Recover a checkpointed job">
              <submit/>
            </default-field>
          </field>
        </form-single>
        <render-mode>
          <text type="html"><![CDATA[</form>]]></text>
        </render-mode>
      </widgets>
    </section>
    <section name="PassOperationsPreviewOperationSection" condition="view.forms.some(form =&gt; form.op === 'previewOperation')">
      <widgets>
        <render-mode>
          <text type="html"><![CDATA[<form method="post" id="PassOperationsPreviewOperation" action="${publicPath}/save"><h2>Preview an operation</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">]]></text>
        </render-mode>
