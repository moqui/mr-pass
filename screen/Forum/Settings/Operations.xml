        </render-mode>
      </widgets>
    </section>
    <section name="PassOperationsDecideDataRequestSection" condition="view.forms.some(form =&gt; form.op === 'decideDataRequest')">
      <widgets>
        <render-mode>
          <text type="html"><![CDATA[<form method="post" id="PassOperationsDecideDataRequest" action="${publicPath}/save"><h2>Decide an erasure request</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">]]></text>
        </render-mode>
        <form-single name="PassOperationsDecideDataRequest" transition="save" map="Object.assign({},view.formValues['decideDataRequest'] || {},ec.web.parameters)" skip-start="true" skip-end="true">
