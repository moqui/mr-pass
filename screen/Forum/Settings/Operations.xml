          </field>
        </form-single>
        <render-mode>
          <text type="html"><![CDATA[</form>]]></text>
        </render-mode>
      </widgets>
    </section>
    <section name="PassOperationsStartOperationSection" condition="view.forms.some(form =&gt; form.op === 'startOperation')">
      <widgets>
        <render-mode>
          <text type="html"><![CDATA[<form method="post" id="PassOperationsStartOperation" action="${publicPath}/save"><h2>Start an operation</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">]]></text>
        </render-mode>
        <form-single name="PassOperationsStartOperation" transition="save" map="Object.assign({},view.formValues['startOperation'] || {},ec.web.parameters)" skip-start="true" skip-end="true">
          <field name="formAction">
