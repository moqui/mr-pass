              <hidden/>
            </default-field>
          </field>
          <field name="scopeType">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="operation">
            <default-field title="Operation">
              <drop-down allow-empty="false">
                <option key="rebuild-counters" text="rebuild-counters"/>
                <option key="retry-deliveries" text="retry-deliveries"/>
                <option key="retention" text="retention"/>
                <option key="export-site" text="export-site"/>
              </drop-down>
            </default-field>
          </field>
          <field name="contactListId">
            <default-field title="Category (optional)">
              <text-line input-type="text"/>
            </default-field>
          </field>
          <field name="submitAction">
            <default-field title="Preview an operation">
              <submit/>
