<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" require-authentication="false" default-menu-title="Policies">
  <transition name="save">
    <actions>
      <script><![CDATA[
        const saved=ec.resource.script('component://mr-pass/screen/Shared/View.js').save('Policies',resolvedSiteId,ec.web.parameters)
        if(ec.web.parameters.formAction==='testRule' && !ec.web.request.getHeader('accept')?.includes('application/json')){ec.web.response.setContentType('text/html');ec.web.response.write('<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Rule test</title><main style="max-width:45rem;margin:2rem auto;font:1rem/1.6 system-ui"><h1>Rule test</h1><p>'+(saved.matched?'The rule matches this text.':'The rule does not match this text.')+'</p><p>Censored display: '+saved.censored+'</p><a href="'+WebUtilities.encodeHtml(publicPath.replace(/\/save$/, ''))+'">Return to policies</a></main></html>');return}
        if(ec.web.parameters.formAction?.startsWith('preview') && ec.web.response){ec.web.response.setContentType('text/html');ec.web.response.write(ec.resource.script('component://mr-pass/screen/Shared/View.js').preview(saved,publicPath.replace(/\/save$/, '')));return}
        if (ec.web.request.getHeader('accept')?.includes('application/json')) ec.web.sendJsonResponse(saved)
        else ec.web.response.sendRedirect(publicPath.replace(/\/save$/, '') + '?saved=true')
    ]]></script>
    </actions>
    <default-response type="none"/>
  </transition>
  <actions>
    <script><![CDATA[
        screenName='Policies'
        view=ec.resource.script('component://mr-pass/screen/Shared/View.js').load(screenName,siteId,ec.web.parameters,passBases,siteInfo)
    ]]></script>
  </actions>
