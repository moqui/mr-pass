<template>
    <section aria-label="Topic posts">
        <p role="status" aria-live="polite">{{ status }}</p>
        <article
            v-for="post in posts"
            :key="post.postId"
            :id="'post-' + post.postId"
            :data-post-id="post.postId"
            :data-ordinal="post.ordinal"
        >
            <p>
                {{
                    post.author.displayName ||
                    post.author.handle ||
                    'Community member'
                }}
                · {{ formatDate(post.entryDate) }}
            </p>
            <p v-if="post.accepted"><strong>Accepted answer</strong></p>
            <p v-if="post.wiki">Wiki post: eligible members may improve it</p>
            <nav aria-label="Post actions" class="post-actions">
                <a :href="forumBase + '/p/' + post.postId">Link to this post</a>
                <a
                    v-if="post.capabilities.canEdit"
                    :href="forumBase + '/Compose?postId=' + post.postId"
                    >Edit post</a
                >
                <a
                    v-if="post.hasHistory"
                    :href="
                        forumBase +
                        '/Topics/PostHistory?postId=' +
                        encodeURIComponent(post.postId)
                    "
                    >History</a
                >
                <a
                    v-if="topic.canFlag"
                    :href="
                        '?postId=' +
                        encodeURIComponent(post.postId) +
                        '#PassTopicDetailFlagPost'
                    "
                    >Report</a
                >
                <a
                    v-if="topic.signedIn"
                    :href="
                        '?postId=' +
                        encodeURIComponent(post.postId) +
                        '#PassTopicDetailStoreBookmark'
                    "
                    >Bookmark</a
                >
                <a
                    v-if="
                        topic.canAccept &&
                        !post.accepted &&
                        post.postId !== post.rootCommEventId &&
                        post.visibility === 'approved'
                    "
                    :href="
                        '?postId=' +
                        encodeURIComponent(post.postId) +
                        '#PassTopicDetailAcceptAnswer'
                    "
                    >Accept answer</a
                >
                <a
                    v-if="post.capabilities.canDelete"
                    :href="
                        '?postId=' +
                        encodeURIComponent(post.postId) +
                        '&expectedRevision=' +
                        post.revision +
                        '#PassTopicDetailDeletePost'
                    "
                    >Delete</a
                >
            </nav>
            <m-html-view :html="post.body" :images-bar="false"></m-html-view>
            <section
                v-if="post.pollId && polls[post.pollId]"
                class="poll"
                aria-label="Poll"
            >
                <h3>{{ polls[post.pollId].question }}</h3>
                <fieldset v-if="polls[post.pollId].canVote">
                    <legend>
                        Choose up to {{ polls[post.pollId].maxChoices }}
                    </legend>
                    <label
                        v-for="option in polls[post.pollId].options"
                        :key="option.optionId"
                        ><input
                            :type="
                                polls[post.pollId].maxChoices > 1
                                    ? 'checkbox'
                                    : 'radio'
                            "
                            :name="'poll-' + post.pollId"
                            :value="option.optionId"
                            v-model="choices[post.pollId]"
                        />
                        {{ option.label }}</label
                    >
                    <button type="button" @click="vote(post.pollId)">
                        Vote
                    </button>
                </fieldset>
                <ul v-if="polls[post.pollId].voterCount != null">
                    <li
                        v-for="option in polls[post.pollId].options"
                        :key="option.optionId"
                    >
                        {{ option.label }}: {{ option.voteCount }}
                        <span v-if="option.voters && option.voters.length"
                            >({{ option.voters.join(', ') }})</span
                        >
                    </li>
                </ul>
                <p v-else>Results appear after you vote.</p>
            </section>
            <div
                v-if="
                    post.capabilities.canReact ||
                    Object.keys(post.reactions || {}).length
                "
                class="reactions"
                aria-label="Reactions"
            >
                <template v-for="key in reactionKeys" :key="key">
                    <button
                        v-if="post.capabilities.canReact"
                        type="button"
                        :aria-pressed="post.myReactions.includes(key)"
                        @click="react(post, key)"
                    >
                        {{ key }} {{ post.reactions[key] || 0 }}
                    </button>
                    <span v-else-if="post.reactions[key]"
                        >{{ key }} {{ post.reactions[key] }}</span
                    >
                </template>
            </div>
            <ul v-if="post.attachments.length">
                <li
                    v-for="attachment in post.attachments"
                    :key="attachment.attachmentId"
                >
                    <img
                        v-if="attachment.mimeType.startsWith('image/')"
                        :src="
                            base +
                            '/download?variant=thumbnail&amp;attachmentId=' +
                            encodeURIComponent(attachment.attachmentId)
                        "
                        :alt="attachment.altText || 'Attached image'"
                        loading="lazy"
                    /><a
                        :href="
                            base +
                            '/download?attachmentId=' +
                            encodeURIComponent(attachment.attachmentId)
                        "
                        >{{ attachment.filename }}</a
                    >
                </li>
            </ul>
        </article>
        <a v-if="nextCursor" :href="nextUrl">Next page</a>
    </section>
</template>
<script>
module.exports = {
    name: 'PassTopicStream',
    data() {
        return {
            posts: [],
            nextCursor: null,
            marker: null,
            status: '',
            base: '',
            forumBase: '',
            observed: new Set(),
            timer: null,
            poll: null,
            observer: null,
            busy: false,
            topic: {},
            polls: {},
            choices: {},
            reactionKeys: ['like', 'thanks', 'insightful', 'agree', 'laugh'],
        }
    },
    async mounted() {
        this.base = location.pathname
        this.forumBase = this.$root.config.context.forumBase
        try {
            await this.load()
            const fallback = document.getElementById('pass-ssr-posts')
            if (fallback) fallback.remove()
            this.observe()
            this.poll = setInterval(() => this.load(true), 15000)
        } catch (e) {
            this.status =
                'Enhanced reading is unavailable. The server-rendered posts remain below.'
        }
    },
    computed: {
        nextUrl() {
            const params = new URLSearchParams(location.search)
            params.set('cursor', this.nextCursor)
            return this.base + '?' + params.toString()
        },
    },
    beforeUnmount() {
        clearInterval(this.poll)
        clearTimeout(this.timer)
        if (this.observer) this.observer.disconnect()
    },
    methods: {
        formatDate(value) {
            return new Date(
                Number.isFinite(Number(value)) ? Number(value) : String(value),
            ).toLocaleString()
        },
        async load(refresh) {
            const response = await fetch(
                this.base + '/state' + location.search,
                { headers: { Accept: 'application/json' } },
            )
            if (
                response.status === 401 ||
                response.status === 403 ||
                response.status === 404
            ) {
                this.posts = []
                this.status =
                    'Your access changed. Sign in or return to the topic list.'
                clearInterval(this.poll)
                return
            }
            if (!response.ok) throw new Error('Topic unavailable')
            const data = await response.json()
            // Reapply the current projection even if an external membership change missed a generation update.
            this.posts = data.postList
            this.topic = data.topic || {}
            this.polls = data.polls || {}
            for (const [pollId, poll] of Object.entries(this.polls))
                if (!(pollId in this.choices))
                    this.choices[pollId] =
                        poll.maxChoices > 1
                            ? [...poll.myChoices]
                            : poll.myChoices[0] || ''
            this.nextCursor = data.nextCursor
            this.revision = data.revision
            this.generation = data.generation
            this.$nextTick(() => this.observe())
            this.marker = data.marker
        },
        // Actions post to the same save transition the plain forms use, asking for JSON instead of a redirect.
        async act(input) {
            const response = await fetch(this.base + '/save', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    Accept: 'application/json',
                    'X-CSRF-Token': moqui.sessionToken,
                },
                body: JSON.stringify({
                    ...input,
                    operationId: crypto.randomUUID().replaceAll('-', ''),
                    moquiSessionToken: moqui.sessionToken,
                }),
            })
            if (!response.ok) throw new Error('Action failed')
            return response.json()
        },
        async react(post, key) {
            try {
                await this.act({
                    formAction: 'setReaction',
                    postId: post.postId,
                    reactionKey: key,
                    active: !post.myReactions.includes(key),
                })
                await this.load(true)
            } catch (e) {
                this.status = 'Your reaction was not saved. Try again.'
            }
        },
        async vote(pollId) {
            const choice = this.choices[pollId]
            const optionIds = Array.isArray(choice) ? choice : [choice]
            if (!optionIds.filter(Boolean).length) return
            try {
                await this.act({ formAction: 'votePoll', pollId, optionIds })
                await this.load(true)
                this.status = 'Your vote was recorded.'
            } catch (e) {
                this.status = 'Your vote was not recorded. Try again.'
            }
        },
        observe() {
            if (this.observer) this.observer.disconnect()
            if (!this.marker) return
            this.observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (
                            entry.isIntersecting &&
                            entry.intersectionRatio >= 0.5
                        )
                            this.observed.add(entry.target.dataset.postId)
                    }
                    clearTimeout(this.timer)
                    this.timer = setTimeout(() => this.mark(), 1500)
                },
                { threshold: [0.5] },
            )
            for (const element of this.$el.querySelectorAll('[data-post-id]'))
                this.observer.observe(element)
        },
        async mark() {
            if (
                this.busy ||
                !this.marker ||
                !this.observed.size ||
                document.hidden
            )
                return
            const seen = this.posts.filter((p) => this.observed.has(p.postId))
            if (!seen.length) return
            const ordinal = Math.max(...seen.map((p) => Number(p.ordinal)))
            if (ordinal <= Number(this.marker.consumedOrdinal || 0)) return
            this.busy = true
            try {
                // The query names the conversation on a Messages page; a topic URL carries its ID in the path.
                const response = await fetch(
                    this.base + '/read' + location.search,
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': moqui.sessionToken,
                        },
                        body: JSON.stringify({
                            ordinal,
                            expectedRevision: this.marker.markerRevision,
                            renderedPostIds: seen.map((p) => p.postId),
                            moquiSessionToken: moqui.sessionToken,
                        }),
                    },
                )
                if (response.status === 409) {
                    await this.load(true)
                    return
                }
                if (response.ok) this.marker = (await response.json()).marker
            } catch (e) {
                this.status =
                    'Reading position will retry when the connection returns.'
            } finally {
                this.busy = false
            }
        },
    },
}
</script>
