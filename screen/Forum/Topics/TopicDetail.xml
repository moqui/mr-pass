<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" require-authentication="false" default-menu-title="TopicDetail">
  <transition name="download" method="get" read-only="true">
    <actions>
      <script>ec.resource.script('component://mr-pass/service/pass/Facade.js').download(resolvedSiteId,ec.web.parameters.attachmentId,ec.web.parameters.variant)</script>
    </actions>
    <default-response type="none"/>
  </transition>
  <transition name="save">
    <actions>
      <script><![CDATA[
        const saved=ec.resource.script('component://mr-pass/screen/Shared/View.js').save('TopicDetail',resolvedSiteId,ec.web.parameters)
        if(ec.web.parameters.formAction?.startsWith('preview') && ec.web.response){ec.web.response.setContentType('text/html');ec.web.response.write(ec.resource.script('component://mr-pass/screen/Shared/View.js').preview(saved,publicPath.replace(/\/save$/, '')));return}
        if (ec.web.request.getHeader('accept')?.includes('application/json')) ec.web.sendJsonResponse(saved)
        else ec.web.response.sendRedirect(publicPath.replace(/\/save$/, '') + '?saved=true')
    ]]></script>
    </actions>
    <default-response type="none"/>
  </transition>
  <transition name="state" method="get" read-only="true">
    <actions>
      <script><![CDATA[
        const call=(operation,input)=>ec.service.sync().throwOnError(true).name('pass.Facade.call#Operation').parameters({operation,input:Object.assign({siteId:resolvedSiteId,rootCommEventId},input || {})}).call().result
        const window={};for(const key of ['cursor','around','before','after'])if(ec.web.parameters[key]!=null)window[key]=ec.web.parameters[key];const data=call('getPosts',window)
        data.marker=call('getTopic',{}).topic.marker
        ec.web.sendJsonResponse(data)
    ]]></script>
    </actions>
    <default-response type="none"/>
  </transition>
  <transition name="read">
    <actions>
      <script><![CDATA[
        ec.web.sendJsonResponse(ec.service.sync().throwOnError(true).name('pass.Facade.call#Operation').parameters({operation:'markRead',input:{siteId:resolvedSiteId,rootCommEventId,ordinal:Number(ec.web.parameters.ordinal),expectedRevision:Number(ec.web.parameters.expectedRevision),renderedPostIds:ec.web.parameters.renderedPostIds || []}}).call().result)
    ]]></script>
    </actions>
    <default-response type="none"/>
  </transition>
  <pre-actions>
    <script><![CDATA[
        topicMetadata=ec.service.sync().throwOnError(true).name('pass.Facade.call#Operation').parameters({operation:'getTopic',input:{siteId:resolvedSiteId,rootCommEventId}}).call().result.topic
        canonicalUrl=(passBases.forum || '')+'/t/'+encodeURIComponent(rootCommEventId)+'/'+encodeURIComponent(topicMetadata.slug)
        if(ec.web.request?.method==='GET' && (typeof requestedTopicSlug==='undefined' || requestedTopicSlug!==topicMetadata.slug)) { sri.sendRedirectAndStopRender(canonicalUrl+(ec.web.parameters.around?'?around='+encodeURIComponent(ec.web.parameters.around):''));return }
    ]]></script>
  </pre-actions>
  <actions>
    <script><![CDATA[
        screenName='TopicDetail'
        view=ec.resource.script('component://mr-pass/screen/Shared/View.js').load(screenName,siteId,Object.assign({},ec.web.parameters,{rootCommEventId,topicMetadata}),passBases,siteInfo)
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Shared/Page.html.fancy"/>
      <text type="qvue" location="component://mr-pass/screen/Forum/Topics/TopicDetail.qvue" template="false"/>
    </render-mode>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Shared/TopicEnhance.html.fancy"/>
    </render-mode>
    <section name="PassTopicDetailSetPreferencesSection" condition="view.forms.some(form =&gt; form.op === 'setPreferences')">
