<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" require-authentication="false" default-menu-title="ReviewDetail">
  <transition name="save">
    <actions>
      <script><![CDATA[
        const saved=ec.resource.script('component://mr-pass/screen/Shared/View.js').save('ReviewDetail',resolvedSiteId,ec.web.parameters)
        if(ec.web.parameters.formAction?.startsWith('preview') && ec.web.response){ec.web.response.setContentType('text/html');ec.web.response.write(ec.resource.script('component://mr-pass/screen/Shared/View.js').preview(saved,publicPath.replace(/\/save$/, '')));return}
        if (ec.web.request.getHeader('accept')?.includes('application/json')) ec.web.sendJsonResponse(saved)
        else ec.web.response.sendRedirect(publicPath.replace(/\/save$/, '') + '?saved=true')
    ]]></script>
    </actions>
    <default-response type="none"/>
  </transition>
  <actions>
    <script><![CDATA[
        screenName='ReviewDetail'
        view=ec.resource.script('component://mr-pass/screen/Shared/View.js').load(screenName,siteId,ec.web.parameters,passBases,siteInfo)
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Shared/Page.html.fancy"/>
    </render-mode>
    <section name="PassReviewDetailAddReviewNoteSection" condition="view.forms.some(form =&gt; form.op === 'addReviewNote')">
      <widgets>
        <render-mode>
          <text type="html"><![CDATA[<form method="post" id="PassReviewDetailAddReviewNote" action="${publicPath}/save"><h2>Add a private staff note</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">]]></text>
        </render-mode>
        <form-single name="PassReviewDetailAddReviewNote" transition="save" map="Object.assign({},view.formValues['addReviewNote'] || {},ec.web.parameters)" skip-start="true" skip-end="true">
          <field name="formAction">
            <default-field>
              <hidden default-value="addReviewNote"/>
            </default-field>
          </field>
          <field name="operationId">
            <default-field>
              <hidden default-value="${ec.user.randomString(32)}"/>
            </default-field>
          </field>
          <field name="rootCommEventId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="contactListId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="reviewId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="token">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="returnTo">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeType">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="body">
            <default-field title="Staff note">
              <text-area cols="60" rows="6"/>
            </default-field>
          </field>
          <field name="submitAction">
            <default-field title="Add a private staff note">
              <submit/>
            </default-field>
          </field>
        </form-single>
        <render-mode>
          <text type="html"><![CDATA[</form>]]></text>
        </render-mode>
      </widgets>
    </section>
    <section name="PassReviewDetailClaimReviewSection" condition="view.forms.some(form =&gt; form.op === 'claimReview')">
      <widgets>
        <render-mode>
          <text type="html"><![CDATA[<form method="post" id="PassReviewDetailClaimReview" action="${publicPath}/save"><h2>Claim review</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">]]></text>
        </render-mode>
        <form-single name="PassReviewDetailClaimReview" transition="save" map="Object.assign({},view.formValues['claimReview'] || {},ec.web.parameters)" skip-start="true" skip-end="true">
          <field name="formAction">
            <default-field>
              <hidden default-value="claimReview"/>
            </default-field>
          </field>
          <field name="operationId">
            <default-field>
              <hidden default-value="${ec.user.randomString(32)}"/>
            </default-field>
          </field>
          <field name="rootCommEventId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="contactListId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="reviewId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="token">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="returnTo">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeType">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="expectedRevision">
            <default-field title="Review revision">
              <text-line input-type="number"/>
            </default-field>
          </field>
          <field name="submitAction">
            <default-field title="Claim review">
              <submit/>
            </default-field>
          </field>
        </form-single>
        <render-mode>
          <text type="html"><![CDATA[</form>]]></text>
        </render-mode>
      </widgets>
    </section>
    <section name="PassReviewDetailEscalateReviewSection" condition="view.forms.some(form =&gt; form.op === 'escalateReview')">
      <widgets>
        <render-mode>
          <text type="html"><![CDATA[<form method="post" id="PassReviewDetailEscalateReview" action="${publicPath}/save"><h2>Private context escalation</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">]]></text>
        </render-mode>
        <form-single name="PassReviewDetailEscalateReview" transition="save" map="Object.assign({},view.formValues['escalateReview'] || {},ec.web.parameters)" skip-start="true" skip-end="true">
          <field name="formAction">
            <default-field>
              <hidden default-value="escalateReview"/>
            </default-field>
          </field>
          <field name="operationId">
            <default-field>
              <hidden default-value="${ec.user.randomString(32)}"/>
            </default-field>
          </field>
          <field name="rootCommEventId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="contactListId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="reviewId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="token">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="returnTo">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeType">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="reason">
            <default-field title="Reason">
              <text-line input-type="text"/>
            </default-field>
          </field>
          <field name="active">
            <default-field title="Approve the requested escalation (site owner)">
              <check>
                <option key="true" text="Confirm"/>
              </check>
            </default-field>
          </field>
          <field name="submitAction">
            <default-field title="Private context escalation">
              <submit/>
            </default-field>
          </field>
        </form-single>
        <render-mode>
          <text type="html"><![CDATA[</form>]]></text>
        </render-mode>
      </widgets>
    </section>
    <section name="PassReviewDetailDecideReviewSection" condition="view.forms.some(form =&gt; form.op === 'decideReview')">
      <widgets>
        <render-mode>
          <text type="html"><![CDATA[<form method="post" id="PassReviewDetailDecideReview" action="${publicPath}/save"><h2>Record decision</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">]]></text>
        </render-mode>
        <form-single name="PassReviewDetailDecideReview" transition="save" map="Object.assign({},view.formValues['decideReview'] || {},ec.web.parameters)" skip-start="true" skip-end="true">
          <field name="formAction">
            <default-field>
              <hidden default-value="decideReview"/>
            </default-field>
          </field>
          <field name="operationId">
            <default-field>
              <hidden default-value="${ec.user.randomString(32)}"/>
            </default-field>
          </field>
          <field name="rootCommEventId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="contactListId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="reviewId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="token">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="returnTo">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeType">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="decision">
            <default-field title="Decision">
              <drop-down allow-empty="false">
                <option key="approved" text="approved"/>
                <option key="rejected" text="rejected"/>
                <option key="dismissed" text="dismissed"/>
              </drop-down>
            </default-field>
          </field>
          <field name="reason">
            <default-field title="Reason">
              <text-line input-type="text"/>
            </default-field>
          </field>
          <field name="expectedRevision">
            <default-field title="Review revision">
              <text-line input-type="number"/>
            </default-field>
          </field>
          <field name="submitAction">
            <default-field title="Record decision">
              <submit/>
            </default-field>
          </field>
        </form-single>
        <render-mode>
          <text type="html"><![CDATA[</form>]]></text>
        </render-mode>
      </widgets>
    </section>
  </widgets>
</screen>
