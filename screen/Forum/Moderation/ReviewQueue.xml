<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" require-authentication="false" default-menu-title="ReviewQueue">
  <transition name="save">
    <actions>
      <script><![CDATA[
        const saved=ec.resource.script('component://mr-pass/screen/Shared/View.js').save('ReviewQueue',resolvedSiteId,ec.web.parameters)
        if(ec.web.parameters.formAction?.startsWith('preview') && ec.web.response){ec.web.response.setContentType('text/html');ec.web.response.write(ec.resource.script('component://mr-pass/screen/Shared/View.js').preview(saved,publicPath.replace(/\/save$/, '')));return}
        if (ec.web.request.getHeader('accept')?.includes('application/json')) ec.web.sendJsonResponse(saved)
        else ec.web.response.sendRedirect(publicPath.replace(/\/save$/, '') + '?saved=true')
    ]]></script>
    </actions>
    <default-response type="none"/>
  </transition>
  <actions>
    <script><![CDATA[
        screenName='ReviewQueue'
        view=ec.resource.script('component://mr-pass/screen/Shared/View.js').load(screenName,siteId,ec.web.parameters,passBases,siteInfo)
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Shared/Page.html.fancy"/>
    </render-mode>
    <section name="PassReviewQueueDecideReviewsSection" condition="view.rows.length &gt; 0 &amp;&amp; view.forms.some(form =&gt; form.op === 'decideReviews')">
      <widgets>
        <render-mode>
          <text type="html"><![CDATA[<form method="post" id="PassReviewQueueDecideReviews" action="${publicPath}/save"><h2>Decide selected reviews</h2><p>Every selected item gets the same decision; each one is checked and recorded on its own.</p><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">]]></text>
        </render-mode>
        <form-single name="PassReviewQueueDecideReviews" transition="save" skip-start="true" skip-end="true">
          <field name="formAction">
            <default-field>
              <hidden default-value="decideReviews"/>
            </default-field>
          </field>
          <field name="reviewIds">
            <default-field title="Reviews">
              <check>
                <list-options list="view.rows" key="reviewId" text="${title}"/>
              </check>
            </default-field>
          </field>
          <field name="decision">
            <default-field title="Decision">
              <drop-down allow-empty="false">
                <option key="approved" text="approved"/>
                <option key="rejected" text="rejected"/>
                <option key="dismissed" text="dismissed"/>
              </drop-down>
            </default-field>
          </field>
          <field name="reason">
            <default-field title="Reason">
              <text-line input-type="text"/>
            </default-field>
          </field>
          <field name="submitAction">
            <default-field title="Decide selected reviews">
              <submit/>
            </default-field>
          </field>
        </form-single>
        <render-mode>
          <text type="html"><![CDATA[</form>]]></text>
        </render-mode>
      </widgets>
    </section>
  </widgets>
</screen>
