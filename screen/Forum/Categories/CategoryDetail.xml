<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" require-authentication="false" default-menu-title="CategoryDetail">
  <transition name="save">
    <actions>
      <script><![CDATA[
        const saved=ec.resource.script('component://mr-pass/screen/Shared/View.js').save('CategoryDetail',resolvedSiteId,ec.web.parameters)
        if(ec.web.parameters.formAction?.startsWith('preview') && ec.web.response){ec.web.response.setContentType('text/html');ec.web.response.write(ec.resource.script('component://mr-pass/screen/Shared/View.js').preview(saved,publicPath.replace(/\/save$/, '')));return}
        if (ec.web.request.getHeader('accept')?.includes('application/json')) ec.web.sendJsonResponse(saved)
        else ec.web.response.sendRedirect(publicPath.replace(/\/save$/, '') + '?saved=true')
    ]]></script>
    </actions>
    <default-response type="none"/>
  </transition>
  <actions>
    <script><![CDATA[
        screenName='CategoryDetail'
        view=ec.resource.script('component://mr-pass/screen/Shared/View.js').load(screenName,siteId,ec.web.parameters,passBases,siteInfo)
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Shared/Page.html.fancy"/>
    </render-mode>
    <section name="PassCategoryDetailJoinCategorySection" condition="view.forms.some(form =&gt; form.op === 'joinCategory')">
      <widgets>
        <render-mode>
          <text type="html"><![CDATA[<form method="post" id="PassCategoryDetailJoinCategory" action="${publicPath}/save"><h2>Join category</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">]]></text>
        </render-mode>
        <form-single name="PassCategoryDetailJoinCategory" transition="save" map="Object.assign({},view.formValues['joinCategory'] || {},ec.web.parameters)" skip-start="true" skip-end="true">
          <field name="formAction">
            <default-field>
              <hidden default-value="joinCategory"/>
            </default-field>
          </field>
          <field name="operationId">
            <default-field>
              <hidden default-value="${ec.user.randomString(32)}"/>
            </default-field>
          </field>
          <field name="rootCommEventId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="contactListId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="reviewId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="token">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="returnTo">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeType">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="submitAction">
            <default-field title="Join category">
              <submit/>
            </default-field>
          </field>
        </form-single>
        <render-mode>
          <text type="html"><![CDATA[</form>]]></text>
        </render-mode>
      </widgets>
    </section>
    <section name="PassCategoryDetailLeaveCategorySection" condition="view.forms.some(form =&gt; form.op === 'leaveCategory')">
      <widgets>
        <render-mode>
          <text type="html"><![CDATA[<form method="post" id="PassCategoryDetailLeaveCategory" action="${publicPath}/save"><h2>Leave category</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">]]></text>
        </render-mode>
        <form-single name="PassCategoryDetailLeaveCategory" transition="save" map="Object.assign({},view.formValues['leaveCategory'] || {},ec.web.parameters)" skip-start="true" skip-end="true">
          <field name="formAction">
            <default-field>
              <hidden default-value="leaveCategory"/>
            </default-field>
          </field>
          <field name="operationId">
            <default-field>
              <hidden default-value="${ec.user.randomString(32)}"/>
            </default-field>
          </field>
          <field name="rootCommEventId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="contactListId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="reviewId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="token">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="returnTo">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeType">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="submitAction">
            <default-field title="Leave category">
              <submit/>
            </default-field>
          </field>
        </form-single>
        <render-mode>
          <text type="html"><![CDATA[</form>]]></text>
        </render-mode>
      </widgets>
    </section>
    <section name="PassCategoryDetailSetPreferencesSection" condition="view.forms.some(form =&gt; form.op === 'setPreferences')">
      <widgets>
        <render-mode>
          <text type="html"><![CDATA[<form method="post" id="PassCategoryDetailSetPreferences" action="${publicPath}/save"><h2>Category notifications</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">]]></text>
        </render-mode>
        <form-single name="PassCategoryDetailSetPreferences" transition="save" map="Object.assign({},view.formValues['setPreferences'] || {},ec.web.parameters)" skip-start="true" skip-end="true">
          <field name="formAction">
            <default-field>
              <hidden default-value="setPreferences"/>
            </default-field>
          </field>
          <field name="operationId">
            <default-field>
              <hidden default-value="${ec.user.randomString(32)}"/>
            </default-field>
          </field>
          <field name="rootCommEventId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="contactListId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="reviewId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="token">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="returnTo">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeType">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="watchLevel">
            <default-field title="Notifications">
              <drop-down allow-empty="false">
                <option key="Normal" text="Normal"/>
                <option key="Muted" text="Muted"/>
                <option key="Tracking" text="Tracking"/>
                <option key="Watching" text="Watching"/>
                <option key="WatchingFirstPost" text="WatchingFirstPost"/>
              </drop-down>
            </default-field>
          </field>
          <field name="emailMode">
            <default-field title="Email">
              <drop-down allow-empty="false">
                <option key="Notifications" text="Notifications"/>
                <option key="None" text="None"/>
                <option key="Digest" text="Digest"/>
                <option key="EveryPost" text="EveryPost"/>
              </drop-down>
            </default-field>
          </field>
          <field name="expectedRevision">
            <default-field title="Preference revision">
              <hidden/>
            </default-field>
          </field>
          <field name="submitAction">
            <default-field title="Category notifications">
              <submit/>
            </default-field>
          </field>
        </form-single>
        <render-mode>
          <text type="html"><![CDATA[</form>]]></text>
        </render-mode>
      </widgets>
    </section>
  </widgets>
</screen>
