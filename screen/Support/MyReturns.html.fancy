<h1>${ec.l10n.localize("My returns")}</h1>
<#if flash.notice><p role="status" class="card">${flash.notice}</p></#if>
<#if !siteInfo.authenticated><p>${ec.l10n.localize("Sign in to follow your returns, or open the link in our return email.")}</p><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath || '')}">${ec.l10n.localize("Sign in")}</a></p>
<#elseif failure><p role="alert" class="error">${failure.message}</p>
<#else><#if view.capabilities.canRequestReturn><p><a href="${passBases.support}/RequestReturn">${ec.l10n.localize("Request a return")}</a></p></#if>
<form method="get" id="MyReturnFind" class="card" role="search" action="${publicPath}"><label>${ec.l10n.localize("Order or reference")} <input type="search" name="q" value="${query || ''}" maxlength="60"></label><#if (view.customers.length > 1)><label>${ec.l10n.localize("For customer")} <select name="customerPartyId"><option value="">${ec.l10n.localize("Everyone I act for")}</option><#list view.customers as c><option value="${c.partyId}"<#if customerPartyId == c.partyId> selected</#if>>${c.name}</option></#list></select></label></#if><button>${ec.l10n.localize("Find")}</button></form>
<section id="MyReturnList" aria-label="${ec.l10n.localize("Returns")}"><#if !view.returnList.length><p class="card">${ec.l10n.localize("No returns to show.")}</p></#if>
<#list view.returnList as r><article class="card"><h2><#if r.canOpen><a href="${passBases.support}/CustomerReturn?returnId=${encodeURIComponent(r.returnId)}">${ec.resource.expand("Return ${r.reference}", "", {r: r})}</a><#else>${ec.resource.expand("Return ${r.reference}", "", {r: r})}</#if></h2><p><strong>${r.statusText}</strong><#if r.orderId> ${ec.resource.expand("· order ${r.orderId}", "", {r: r})}</#if><#if r.customerReference> ${ec.resource.expand("· your reference ${r.customerReference}", "", {r: r})}</#if></p>
<p><small>${ec.resource.expand("Requested ${r.requestedQuantity}", "", {r: r})}<#if r.approvedQuantity>${ec.resource.expand(" · authorized ${r.approvedQuantity}", "", {r: r})}</#if>${ec.resource.expand(" · received ${r.receivedQuantity}", "", {r: r})}<#if r.remedyText> · ${r.remedyText}</#if><#if r.expiryText> ${ec.resource.expand("· send by ${r.expiryText}", "", {r: r})}</#if><#if r.trackingText> ${ec.resource.expand("· tracking ${r.trackingText}", "", {r: r})}</#if></small></p></article></#list></section>
<#if nextHref || firstHref><nav class="card" aria-label="${ec.l10n.localize("More returns")}"><#if firstHref><a href="${firstHref}">${ec.l10n.localize("Newest returns")}</a> </#if><#if nextHref><a href="${nextHref}" id="MyReturnsMore">${ec.l10n.localize("Older returns")}</a></#if></nav></#if></#if>
