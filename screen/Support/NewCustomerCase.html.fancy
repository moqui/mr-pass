<h1>${ec.l10n.localize("Contact support")}</h1>
<#if flash.notice><p role="status" class="card">${flash.notice}</p></#if><#if flash.error><p role="alert" class="error">${flash.error}</p></#if>
<#if failure><p role="alert" class="error">${failure.message}</p><#if failure.kind == 'AuthenticationRequired'><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath || '')}">${ec.l10n.localize("Sign in")}</a></p></#if>
<#elseif received><section class="card" id="CaseReceipt" aria-live="polite"><h2>${ec.l10n.localize("Thank you")}</h2><p>${ec.l10n.localize("We have your request and will answer you by email.")}</p></section>
<#else>
<#if orderToken && orderId><section class="card" id="OrderChangeCode"><h2>${ec.l10n.localize("Your code")}</h2><p>${ec.l10n.localize("To send a request about this order from its link, enter the code we email to the order's address. It works once, for 15 minutes.")}</p><form method="post" action="${publicPath}/sendCode"><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="orderId" value="${orderId}"><button>${ec.l10n.localize("Email me a code")}</button></form></section></#if>
<#if view.order><section class="card" id="OrderCancelRequest"><h2>${ec.resource.expand("Cancel order ${view.order.orderId}", "", {view: view})}</h2><#if view.order.placedText><p><small>${ec.resource.expand("Placed ${view.order.placedText}", "", {view: view})}</small></p></#if>
<#list view.order.requestList as r><p><strong>${r.stateText}</strong>${ec.resource.expand(" · asked ${r.requestedText}", "", {r: r})}<#list r.lines as l> · ${l.productText} × ${l.quantity}</#list></p></#list>
<#if view.order.capabilities.canRequestCancel><form method="post" action="${publicPath}/cancelOrder"><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="orderId" value="${view.order.orderId}"><input type="hidden" name="operationId" value="${cancelOperationId}">
<fieldset><legend>${ec.l10n.localize("Lines to cancel")}</legend><#list view.order.lines as l><div class="field"><label><input type="checkbox" name="cancel_${l.orderItemSeqId}" value="Y"> ${l.productText}</label><label>${ec.resource.expand("Quantity (up to ${l.openQuantity})", "", {l: l})} <input name="quantity_${l.orderItemSeqId}" value="${l.openQuantity}" inputmode="decimal" size="6"></label></div></#list></fieldset>
<label>${ec.l10n.localize("Why do you want to cancel?")} <textarea name="reason" rows="3" maxlength="2000"></textarea></label>
<label><input type="checkbox" name="consent" value="Y" required> ${ec.resource.expand("I ask ${view.organizationName} to cancel these lines", "", {view: view})}</label><#if orderToken><label>${ec.l10n.localize("Code from the email *")} <input name="changeCode" inputmode="numeric" pattern="[0-9]{8}" maxlength="8" autocomplete="one-time-code" required></label></#if>
<p><button>${ec.l10n.localize("Ask to cancel")}</button></p><p><small>${ec.l10n.localize("Anything already shipped cannot be cancelled here; we confirm what we cancel.")}</small></p></form>
<#else><p>${ec.l10n.localize("Nothing on this order can be cancelled here now. Send us a request below.")}</p></#if></section></#if>
<#if queue && queue.hoursNotice><p class="card" role="status">${ec.resource.expand("${queue.hoursNotice.message}. We still take your request now.", "", {queue: queue})}</p></#if>
<#if view.articleList.length><section class="card" aria-label="${ec.l10n.localize("Answers that may help")}"><h2>${ec.l10n.localize("These may answer your question")}</h2><ul><#list view.articleList as a><li><a href="${passBases.support}/CustomerArticle?wikiPageId=${encodeURIComponent(a.wikiPageId)}">${a.title}</a></li></#list></ul></section></#if>
<#if !view.capabilities.canSubmit><p>${ec.l10n.localize("No request form is open for you now.")}</p>
<#else>
<#if (view.queues.length > 1 || (queue && queue.types.length > 1))><form method="get" class="card" action="${publicPath}" id="CaseTopic"><#if token><input type="hidden" name="token" value="${token}"></#if><#if orderId><input type="hidden" name="orderId" value="${orderId}"></#if><#if wikiPageId><input type="hidden" name="wikiPageId" value="${wikiPageId}"></#if>
<#if (view.queues.length > 1)><label>${ec.l10n.localize("Your request is about")} <select name="requestCategoryId"><#list view.queues as q><option value="${q.requestCategoryId}"<#if q.requestCategoryId == queue.requestCategoryId> selected</#if>>${q.name}</option></#list></select></label></#if>
<#if (queue.types.length > 1)><label>${ec.l10n.localize("Kind of request")} <select name="requestTypeEnumId"><#list queue.types as t><option value="${t.requestTypeEnumId}"<#if t.requestTypeEnumId == type.requestTypeEnumId> selected</#if>>${t.text}</option></#list></select></label></#if><button>${ec.l10n.localize("Choose")}</button></form></#if>
<form method="post" enctype="multipart/form-data" id="NewCustomerCaseForm" class="card" action="${publicPath}/submit"><h2>${ec.l10n.localize("Your request")}</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="operationId" value="${submitOperationId}"><input type="hidden" name="fieldNames" value="${fieldNames}">
<#if token><input type="hidden" name="token" value="${token}"></#if><#if orderId><input type="hidden" name="orderId" value="${orderId}"></#if><#if view.article><input type="hidden" name="wikiPageId" value="${view.article.wikiPageId}"><p>${ec.l10n.localize("About the article")} <a href="${passBases.support}/CustomerArticle?wikiPageId=${encodeURIComponent(view.article.wikiPageId)}">${view.article.title}</a></p></#if>
<input type="hidden" name="requestCategoryId" value="${queue.requestCategoryId}"><input type="hidden" name="requestTypeEnumId" value="${type.requestTypeEnumId}">
<#if view.capabilities.needsSender><label>${ec.l10n.localize("First name *")} <input name="firstName" maxlength="60" required autocomplete="given-name"></label><label>${ec.l10n.localize("Last name *")} <input name="lastName" maxlength="60" required autocomplete="family-name"></label><label>${ec.l10n.localize("Email *")} <input type="email" name="emailAddress" maxlength="254" required autocomplete="email"></label><div aria-hidden="true" style="position:absolute;left:-10000px"><label>${ec.l10n.localize("Website")} <input name="website" tabindex="-1" autocomplete="off"></label></div></#if>
<#if (view.customers.length > 1)><label>${ec.l10n.localize("For *")} <select name="customerPartyId" required><#list view.customers as c><option value="${c.partyId}">${c.name}</option></#list></select></label></#if>
<label>${ec.l10n.localize("Subject *")} <input name="requestName" maxlength="255" required value="${query || ''}"></label>
<label>${ec.l10n.localize("What do you need? *")} <textarea name="description" rows="6" maxlength="20000" required></textarea></label>
<#list caseFields as f><div class="field" id="field_${f.fieldName}"<#if f.showText> data-visible-when="${f.showText}"</#if><#if f.requireText> data-require-when="${f.requireText}"</#if>>
<#if f.kind == 'radio'><fieldset><legend>${f.title}<#if f.required> *</#if></legend><#list f.options as o><label><input type="radio" name="tv_${f.fieldName}" value="${o.key}"<#if f.required> required</#if>> ${o.text}</label></#list></fieldset>
<#elseif f.kind == 'checks'><fieldset><legend>${f.title}</legend><#list f.options as o><label><input type="checkbox" name="tv_${f.fieldName}" value="${o.key}"> ${o.text}</label></#list></fieldset>
<#elseif f.kind == 'select'><label>${f.title}<#if f.required> *</#if> <select name="tv_${f.fieldName}"<#if f.required> required</#if>><option value=""></option><#list f.options as o><option value="${o.key}">${o.text}</option></#list></select></label>
<#elseif f.kind == 'textarea'><label>${f.title}<#if f.required> *</#if> <textarea name="tv_${f.fieldName}" rows="3" maxlength="4000"<#if f.required> required</#if>></textarea></label>
<#elseif f.kind == 'date'><label>${f.title}<#if f.required> *</#if> <input type="date" name="tv_${f.fieldName}"<#if f.required> required</#if>></label>
<#else><label>${f.title}<#if f.required> *</#if> <input name="tv_${f.fieldName}" maxlength="255"<#if f.required> required</#if>></label></#if>
<#if f.tooltip><p><small>${f.tooltip}</small></p></#if></div></#list>
<label>${ec.l10n.localize("A file (PDF, PNG or JPEG, at most 10 MB)")} <input type="file" name="file" accept="application/pdf,image/png,image/jpeg"></label><#if orderToken><label>${ec.l10n.localize("Code from the email *")} <input name="changeCode" inputmode="numeric" pattern="[0-9]{8}" maxlength="8" autocomplete="one-time-code" required></label></#if>
<p><button>${ec.l10n.localize("Send request")}</button></p></form><#if caseFields.length><script src="/js/moqui-form-when.js"></script></#if></#if></#if>
