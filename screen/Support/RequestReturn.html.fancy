<h1>${ec.l10n.localize("Request a return")}</h1>
<#if flash.error><p role="alert" class="error">${flash.error}</p></#if>
<#if flash.notice><p role="status" class="card">${flash.notice}</p></#if>
<#if received><section class="card" id="ReturnReceipt" aria-live="polite"><h2>${ec.l10n.localize("Thank you")}</h2><p>${ec.l10n.localize("We have your return request and will email you what to do next.")}</p></section>
<#elseif !siteInfo.authenticated && !orderToken><p>${ec.l10n.localize("Sign in to return something you bought.")}</p><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath || '')}">${ec.l10n.localize("Sign in")}</a></p>
<#elseif failure><p role="alert" class="error">${failure.message}</p>
<#elseif !view.order><section class="card" aria-label="${ec.l10n.localize("Your orders")}"><h2>${ec.l10n.localize("Which order?")}</h2><#if !view.orderList.length><p>${ec.l10n.localize("No orders to return from.")}</p></#if><ul><#list view.orderList as o><li><a href="${publicPath}?orderId=${encodeURIComponent(o.orderId)}">${ec.resource.expand("Order ${o.orderId}", "", {o: o})}</a><#if o.orderName> · ${o.orderName}</#if> · ${o.placedText} · ${o.statusText}</li></#list></ul></section>
<#else><#assign o = view.order><#if orderToken><section class="card" id="OrderChangeCode"><h2>${ec.l10n.localize("Your code")}</h2><p>${ec.l10n.localize("To send a request about this order from its link, enter the code we email to the order's address. It works once, for 15 minutes.")}</p><form method="post" action="${publicPath}/sendCode"><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="orderId" value="${orderId}"><button>${ec.l10n.localize("Email me a code")}</button></form></section></#if><form method="post" enctype="multipart/form-data" id="ReturnRequest" class="card" action="${publicPath}/submit"><h2>${ec.resource.expand("Order ${o.orderId}", "", {o: o})}</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="orderId" value="${o.orderId}"><input type="hidden" name="operationId" value="${submitOperationId}">
<#if view.instructions><p>${view.instructions}</p></#if><#if view.feeText><p><small>${view.feeText}</small></p></#if>
<#list o.lines as l><fieldset class="field"><legend>${l.productText}</legend><#if l.returnable><label><input type="checkbox" name="return_${l.orderItemSeqId}" value="Y"> ${ec.l10n.localize("Return this item")}</label><label>${ec.resource.expand("How many (up to ${l.eligibleQuantity})", "", {l: l})} <input name="quantity_${l.orderItemSeqId}" value="1" inputmode="decimal" size="6"></label>
<label>${ec.l10n.localize("Why")} <select name="reason_${l.orderItemSeqId}"><option value=""></option><#list view.reasons as r><option value="${r.returnReasonEnumId}">${r.text}</option></#list></select></label>
<label>${ec.l10n.localize("What would you like")} <select name="remedy_${l.orderItemSeqId}"><#list l.remedies as m><option value="${m.returnResponseEnumId}">${m.text}</option></#list></select></label>
<label>${ec.l10n.localize("Its condition (optional)")} <input name="condition_${l.orderItemSeqId}" maxlength="255"></label><#if l.windowEndText><p><small>${ec.resource.expand("Return by ${l.windowEndText}", "", {l: l})}</small></p></#if><#if l.evidenceRequired><p><small>${ec.l10n.localize("Add a photo of it below.")}</small></p></#if>
<#else><p>${l.note}</p></#if></fieldset></#list>
<label>${ec.l10n.localize("Your reference (optional)")} <input name="customerReference" maxlength="60"></label><label>${ec.l10n.localize("Anything else we should know (optional)")} <textarea name="note" rows="3" maxlength="2000"></textarea></label>
<label>${ec.l10n.localize("A photo or document (PDF, PNG or JPEG, at most 10 MB)")} <input type="file" name="file" accept="application/pdf,image/png,image/jpeg"></label><#if orderToken><label>${ec.l10n.localize("Code from the email *")} <input name="changeCode" inputmode="numeric" pattern="[0-9]{8}" maxlength="8" autocomplete="one-time-code" required></label></#if>
<p><button>${ec.l10n.localize("Request the return")}</button></p><p><small>${ec.l10n.localize("We review your request and tell you how to send the goods back; what you would like is not yet approved.")}</small></p></form><p><a href="${publicPath}">${ec.l10n.localize("Another order")}</a></p></#if>
