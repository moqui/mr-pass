<h1>${ec.l10n.localize("My cases")}</h1>
<#if flash.notice><p role="status" class="card">${flash.notice}</p></#if>
<#if !siteInfo.authenticated><p>${ec.l10n.localize("Sign in to follow your requests.")}</p><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath || '')}">${ec.l10n.localize("Sign in")}</a></p>
<#elseif failure><p role="alert" class="error">${failure.message}</p>
<#else><#if view.capabilities.canCreateCase><p><a href="${passBases.support}/NewCustomerCase">${ec.l10n.localize("New request")}</a></p></#if>
<form method="get" id="MyCaseFind" class="card" role="search" action="${publicPath}"><label>${ec.l10n.localize("Search")} <input type="search" name="q" value="${query || ''}" maxlength="100"></label>
<label>${ec.l10n.localize("Show")} <select name="statusCategory"><option value="all"<#if statusCategory == 'all'> selected</#if>>${ec.l10n.localize("All")}</option><option value="open"<#if statusCategory == 'open'> selected</#if>>${ec.l10n.localize("Open")}</option><option value="resolved"<#if statusCategory == 'resolved'> selected</#if>>${ec.l10n.localize("Resolved or cancelled")}</option></select></label>
<#if (view.customers.length > 1)><label>${ec.l10n.localize("For customer")} <select name="customerPartyId"><option value="">${ec.l10n.localize("Everyone I act for")}</option><#list view.customers as c><option value="${c.partyId}"<#if customerPartyId == c.partyId> selected</#if>>${c.name}</option></#list></select></label></#if><button>${ec.l10n.localize("Find")}</button></form>
<section id="MyCaseList" aria-label="${ec.l10n.localize("Cases")}"><#if !view.caseList.length><p class="card">${ec.l10n.localize("No cases to show.")}</p></#if>
<#list view.caseList as row><article class="card"><h2><a href="${passBases.support}/CustomerCase?requestId=${encodeURIComponent(row.requestId)}">${row.title}</a></h2><p><strong>${row.statusText}</strong><#if row.needsReply> · <span class="error">${ec.l10n.localize("Needs your reply")}</span></#if></p><p><small>${ec.resource.expand("Case ${row.requestId}", "", {row: row})}<#if (view.customers.length > 1)> · ${row.customerName}</#if> ${ec.resource.expand("· opened ${row.createdText} · updated ${row.updatedText}", "", {row: row})}</small></p></article></#list></section>
<#if nextHref || firstHref><nav class="card" aria-label="${ec.l10n.localize("More cases")}"><#if firstHref><a href="${firstHref}">${ec.l10n.localize("Newest cases")}</a> </#if><#if nextHref><a href="${nextHref}" id="MyCasesMore">${ec.l10n.localize("Older cases")}</a></#if></nav></#if></#if>
