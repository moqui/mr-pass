<#if failure><h1>${ec.l10n.localize("Payment")}</h1><p role="alert" class="error">${failure.message}</p><#if reference><p><a href="${registerPath}?ref=${encodeURIComponent(reference)}">${ec.l10n.localize("Back to your registration")}</a></p></#if>
<#else><section class="card" id="RegistrationRelay"><h1>${ec.l10n.localize("Payment")}</h1>
<form method="post" id="RegistrationPaymentRelay" action="${form.formUrl}"><#list fieldList as f><input type="hidden" name="${f.name}" value="${f.value}"></#list>
<p>${ec.l10n.localize("You pay on the payment provider's page. Your registration is confirmed by the provider's answer, not by returning here.")}</p>
<p><button>${ec.l10n.localize("Continue to the payment page")}</button></p></form></section></#if>
