<!-- VerifySubscription (design-marketing §13 VerifyIntent; IronStone impl-marketing P7): a confirmation link's page. A GET reads the
    request (getSubscriptionRequest: the address masked, the topics with their consent wording, its state) and changes nothing, so
    a mail scanner following the link confirms nothing; the Confirm button posts (verifySubscription) and accepts exactly the
    request's topics, once; a second post shows the first result. A wrong, expired or replaced link shows the same "not
    available". Plain HTML. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        require-authentication="false" default-menu-title="Confirm">
  <transition name="confirm" method="post">
    <actions>
      <script><![CDATA[
        const marketing=ec.resource.script('component://mr-pass/screen/Marketing/Marketing.js')
        const page=marketing.base(publicPath,'confirm')
        const token=marketing.param('token')
        marketing.post('verifySubscription',{siteId:resolvedSiteId,token,operationId:marketing.param('operationId')},
            {path:page,params:{token}},{path:page,params:{token}})
    ]]></script>
    </actions>
    <default-response type="none"/>
  </transition>
  <actions>
    <script><![CDATA[
        const marketing=ec.resource.script('component://mr-pass/screen/Marketing/Marketing.js')
        flash=marketing.take()
        token=marketing.param('token')
        view=null;failure=null
        if(!token)failure={kind:'NotFound',message:ec.l10n.localize("Open this page from the link in the message we sent you.")}
        else{
            const found=marketing.portal.attempt('getSubscriptionRequest',{siteId:resolvedSiteId,token})
            if(found.error)failure=found.error.kind==='NotFound'?{kind:'NotFound',message:ec.l10n.localize("This link is not available. It may have expired or been replaced: ask again from the subscribe page.")}:found.error
            else view=found.result
        }
        confirmOperationId=marketing.portal.operationId()
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Marketing/VerifySubscription.html.fancy"/>
    </render-mode>
  </widgets>
</screen>
