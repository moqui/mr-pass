<!doctype html>
<html lang="${siteInfo.site.locale || 'en'}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="moquiSessionToken" content="${ec.web.sessionToken}"><title>${siteInfo.site.name}</title><link rel="icon" href="data:,"><meta property="og:type" content="website"><meta property="og:title" content="${view?.title || siteInfo.site.name}"><meta property="og:site_name" content="${siteInfo.site.name}"><#if canonicalUrl><link rel="canonical" href="${canonicalUrl}"></#if>
<style>body{font:1rem/1.6 system-ui,sans-serif;max-width:78rem;margin:auto;padding:1rem;color:#243247;background:#f5f7fa}a{color:#1558a6}header,article,form,.card{background:white;padding:1rem;border-radius:.5rem;margin-bottom:1rem}nav{display:flex;flex-wrap:wrap;gap:1rem}main{max-width:65rem;margin:1rem auto}label{display:block;margin:.7rem 0}input,textarea,select,button{font:inherit;max-width:100%;padding:.5rem}fieldset{min-width:0;border:0;padding:0}textarea{display:block;width:95%;min-height:10rem}button{cursor:pointer;min-height:44px}img{max-width:100%}.skip{position:absolute;top:-100px}.skip:focus{top:0}dt{font-weight:600}dd{overflow-wrap:anywhere}.error{color:#962626}#public-root .q-layout,#public-root .q-page{min-height:0!important}@media(prefers-color-scheme:dark){body{background:#17202d;color:#eef3fa}header,article,form,.card{background:#243247}a{color:#9bc9ff}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}</style></head><body>
<a href="#main" class="skip">Skip to discussion</a><header><strong>${siteInfo.site.name}</strong><nav aria-label="Community">
<a href="${passBases.forum}">Topics</a><a href="${passBases.forum}/Categories">Categories</a><a href="${passBases.forum}/Tags">Tags</a><a href="${passBases.forum}/Search">Search</a><a href="${passBases.forum}/Guidelines">Guidelines</a>
<#if siteInfo.authenticated><a href="${passBases.forum}/Compose">New topic</a><a href="${passBases.forum}/Drafts">Drafts</a><a href="${passBases.forum}/Bookmarks">Bookmarks</a><a href="${passBases.forum}/Messages">Messages</a><a href="${passBases.account}/Notifications">Notifications</a><a href="${passBases.account}/Settings">Account</a><#else><a href="${passBases.account}/Login">Sign in</a><#if siteInfo.site.registrationMode == 'open'><a href="${passBases.account}/Register">Register</a></#if></#if>
<#if siteInfo.capabilities.canModerateSite><a href="${passBases.forum}/Moderation/ReviewQueue">Review</a><a href="${passBases.forum}/Moderation/Log">Moderation log</a><a href="${passBases.forum}/Reports/Activity">Activity</a></#if>
<#if siteInfo.capabilities.canManageSite><a href="${passBases.sites}/SiteDetail">Site settings</a><a href="${passBases.forum}/Settings/Categories">Manage categories</a><a href="${passBases.forum}/Settings/Members">Members</a><a href="${passBases.forum}/Settings/Policies">Policies</a><a href="${passBases.forum}/Settings/Mail">Mail</a><a href="${passBases.forum}/Settings/Operations">Operations</a><a href="${passBases.forum}/Settings/Import">Import</a></#if><a href="${passBases.forum}/feed">RSS</a></nav></header><main id="main" tabindex="-1">
