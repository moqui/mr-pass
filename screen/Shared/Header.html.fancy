tools{display:flex;align-items:center;flex-wrap:wrap;gap:.5rem 1rem;margin:.2rem 0 .6rem}.smithy-difftools>h2,.smithy-difftools>h3{margin:0}.smithy-seg{display:flex;margin-left:auto;border:1px solid var(--sm-line);border-radius:4px;overflow:hidden}.smithy-seg a{padding:.15rem .7rem;color:var(--sm-muted)}.smithy-seg a+a{border-left:1px solid var(--sm-line)}.smithy-seg a[aria-current]{background:var(--sm-accent-soft);color:var(--sm-accent);font-weight:600}.smithy-review{display:grid;grid-template-columns:15rem minmax(0,1fr);gap:1rem;align-items:start}.smithy-filelist{min-width:0}.smithy-filetree{position:sticky;top:.5rem;max-height:calc(100vh - 1rem);overflow-y:auto}.smithy-filetree ul.card{padding:.3rem 0;margin:0;width:100%}.smithy-filetree li{padding:.15rem .7rem}.smithy-filetree li a{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--sm-text)}.smithy-filetree li small{display:block;padding-left:1rem}.smithy-filetree li:has(a:hover){background:var(--sm-alt)}.st{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:.45rem;background:#bf8700;vertical-align:middle}.st:is(.st-added,.st-add,.st-new,.st-a){background:#2da44e}.st:is(.st-deleted,.st-delete,.st-removed,.st-d){background:#cf222e}.st:is(.st-renamed,.st-rename,.st-r,.st-copied){background:#0969da}section.card.smithy-file{padding:0;overflow:clip}.smithy-file>details>summary{position:sticky;top:0;z-index:2;display:flex;align-items:center;gap:.5rem;list-style:none;cursor:pointer;padding:.35rem .7rem;background:var(--sm-alt);border-bottom:1px solid var(--sm-line)}.smithy-file>details:not([open])>summary{border-bottom:0}.smithy-file>details>summary::-webkit-details-marker{display:none}.smithy-file>details>summary::before{content:'\25BE';color:var(--sm-muted);font-size:11px;width:1ch}.smithy-file>details:not([open])>summary::before{content:'\25B8'}.smithy-file summary h3{display:flex;align-items:center;flex-wrap:wrap;gap:.5rem;flex:1;margin:0;font:600 12px ui-monospace,SFMono-Regular,Menlo,monospace}.smithy-file summary h3 small{font-family:system-ui,sans-serif;font-weight:400}.smithy-viewfile{margin-left:auto;font:400 12px system-ui,sans-serif}.smithy-file details>p{margin:0;padding:.5rem .7rem}.smithy-file details>.smithy-thread{margin:.4rem .7rem}.smithy-stat{font:400 11px system-ui,sans-serif;white-space:nowrap}.smithy-stat .p{color:#1a7f37}.smithy-stat .m{color:#cf222e}.smithy-stat i{display:inline-block;width:7px;height:7px;margin-left:1px;background:var(--sm-line);vertical-align:middle}.smithy-stat i.a{background:#2da44e}.smithy-stat i.d{background:#cf222e}.smithy-file .smithy-lines{margin:0;line-height:20px}.smithy-lines .l{position:relative}.smithy-lines .l .n,.smithy-lines .l .o{display:inline-block;box-sizing:border-box;width:6ch;min-width:0;margin:0;padding:0 1ch 0 0;text-align:right;color:var(--sm-muted);opacity:1;user-select:none;text-decoration:none}.smithy-lines .l .o{margin-right:1ch}.smithy-lines .l:is(.a,.c) .o{float:left;margin-right:0;height:20px}.smithy-lines .l:is(.a,.c) a.n{margin-right:1ch}.smithy-lines .l>span.n+span.n{margin-right:1ch}.smithy-lines a.n:hover{color:var(--sm-accent);text-decoration:underline}.smithy-lines .l.a{background:var(--sm-add)}.smithy-lines .l.d{background:var(--sm-del)}.smithy-lines .l.a :is(.n,.o){background:var(--sm-add-n)}.smithy-lines .l.d :is(.n,.o){background:var(--sm-del-n)}.smithy-lines .l.h,.smithy-split .sr.h{background:var(--sm-hunk);color:var(--sm-muted);opacity:1;padding-left:13ch}.smithy-split .sr.h{padding-left:7ch}.smithy-lines .l.m,.smithy-split .sr.m{color:var(--sm-muted);padding-left:13ch}.fn{color:var(--sm-text)}.smithy-lines .l.g,.smithy-split .sr.g{display:block;padding:.1rem 0 .1rem 13ch;background:var(--sm-hunk);font-family:system-ui,sans-serif;font-size:12px}.smithy-split .sr.g{padding-left:7ch}.l.a .x,.t.a .x{background:var(--sm-add-x);border-radius:2px}.l.d .x,.t.d .x{background:var(--sm-del-x);border-radius:2px}.smithy-lines .l:target,.smithy-lines .l:has(a.n:target){outline:0;box-shadow:inset 3px 0 #e2a400;background:var(--sm-mark)}.smithy-split{display:grid;grid-template-columns:6ch minmax(0,1fr) 6ch minmax(0,1fr);font:.85rem/20px ui-monospace,SFMono-Regular,Menlo,monospace;tab-size:4}.smithy-split .sr{display:contents}.smithy-split>:not(.sr),.smithy-split .sr:is(.h,.m,.g){grid-column:1/-1}.smithy-split .sr:is(.h,.m){display:block;white-space:pre}.smithy-split .n{padding:0 1ch 0 0;text-align:right;color:var(--sm-muted);user-select:none;text-decoration:none}.smithy-split .t{white-space:pre-wrap;overflow-wrap:anywhere;padding-left:1ch;min-width:0}.smithy-split .n:nth-child(3){border-left:1px solid var(--sm-line)}.smithy-split .t.a{background:var(--sm-add)}.smithy-split .t.d{background:var(--sm-del)}.smithy-split .n:has(+.t.a){background:var(--sm-add-n)}.smithy-split .n:has(+.t.d){background:var(--sm-del-n)}.smithy-split .e{background:var(--sm-alt)}.smithy-split a.n:hover{color:var(--sm-accent)}.smithy-split a.n:target,.smithy-split a.n:target+.t{background:var(--sm-mark)}.smithy-split>.smithy-thread{margin:.4rem .7rem;position:static}.smithy-parts{display:flex;gap:.6rem;align-items:center;padding:.4rem .7rem;color:var(--sm-muted)}.smithy-omitted{margin:0;padding:.5rem .7rem;color:var(--sm-muted)}.smithy-omitted .smithy-btn{margin-left:.4rem}.smithy-imgdiff{display:flex;flex-wrap:wrap;gap:1rem;padding:.8rem}.smithy-imgdiff figure{flex:1 1 14rem;margin:0;text-align:center}.smithy-imgdiff figcaption{font-size:12px;font-weight:600;margin-bottom:.3rem}.smithy-imgdiff .before figcaption{color:#cf222e}.smithy-imgdiff .after figcaption{color:#1a7f37}.smithy-imgdiff img{max-width:100%;max-height:30rem;border:1px solid var(--sm-line);background:repeating-conic-gradient(var(--sm-alt) 0 25%,var(--sm-surface) 0 50%) 0 0/16px 16px}@media(max-width:58rem){.smithy-review{grid-template-columns:minmax(0,1fr)}.smithy-filetree{position:static;max-height:16rem}}</style></#if>
<#if siteInfo.brand><style>${siteInfo.brand.backgroundColor ? 'body{background:' + siteInfo.brand.backgroundColor + '}' : ''}${siteInfo.brand.textColor ? 'body{color:' + siteInfo.brand.textColor + '}' : ''}${siteInfo.brand.surfaceColor ? 'header,article,form,.card{background:' + siteInfo.brand.surfaceColor + '}' : ''}${siteInfo.brand.primaryColor ? 'a{color:' + siteInfo.brand.primaryColor + '}' : ''}</style></#if></head><body>
<#if passApp == 'smithy'><a href="#main" class="skip">${ec.l10n.localize('Skip to content')}</a><header><#if siteInfo.brand?.logoUrl><img src="${siteInfo.brand.logoUrl}" alt="" height="32"> </#if><a href="${passBases.smithy || '/'}"><strong>${siteInfo.site.name}</strong></a><nav aria-label="Code">
<a href="${passBases.smithy}/explore">Explore</a><form method="get" action="${passBases.smithy}/-/search" role="search" class="smithy-inline" id="SmithySearchBox"><input type="search" name="q" maxlength="200" size="12" aria-label="${ec.l10n.localize('Search the site')}"> <button>Search</button></form><#if (siteInfo.mounts || []).some(m => m.app == 'forum')><a href="${passBases.forum || '/'}">Forum</a></#if><span class="smithy-me"><#if siteInfo.authenticated && !passPublicPage><a href="${passBases.smithy}/new/repository">New repository</a><a href="${passBases.smithy}/new/group">New group</a><#if siteInfo.capabilities.canManageSite><a href="${passBases.smithy}/-/site">Site settings</a></#if><a href="${passBases.account}/Home">${ec.l10n.localize('My account')}</a><a href="${passBases.account}/GitAccess">Git access</a><form method="post" action="${passBases.account}/Settings/save" class="smithy-inline" id="SmithySignOut"><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="formAction" value="endSession"><button>Sign out</button></form><#else><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath || '')}">Sign in</a><#if siteInfo.site.registrationMode == 'open'><a href="${passBases.account}/Register">Register</a></#if></#if></span></nav></header><main id="main" tabindex="-1">
<#elseif passApp == 'billing' || passApp == 'supplier' || passApp == 'support' || passApp == 'sales' || passApp == 'marketing' || passApp == 'shop' || !(siteInfo.mounts || []).some(m => m.app == 'forum')><a href="#main" class="skip">${ec.l10n.localize('Skip to content')}</a><header><#if siteInfo.brand?.logoUrl><img src="${siteInfo.brand.logoUrl}" alt="" height="32"> </#if><strong>${siteInfo.site.name}</strong><nav aria-label="${passApp == 'supplier' ? 'Supplier' : passApp == 'support' ? 'Support' : passApp == 'sales' ? 'Sales' : passApp == 'marketing' ? 'Subscriptions' : passApp == 'shop' ? 'Shop' : 'Billing'}">
<#if (siteInfo.mounts || []).some(m => m.app == 'shop')><a href="${passBases.shop || '/'}">Shop</a><#if passApp == 'shop'><a href="${passBases.shop || ''}/Cart">Cart</a><#if siteInfo.authenticated && !passPublicPage><a href="${passBases.shop || ''}/Account">${ec.l10n.localize('Your purchases')}</a></#if></#if></#if><#if passApp == 'support'><a href="${passBases.support}/SupportHome">Help</a><#if siteInfo.authenticated><a href="${passBases.support}/MyCases">My cases</a><a href="${passBases.support}/MyReturns">${ec.l10n.localize('My returns')}</a><a href="${passBases.support}/NewCustomerCase">${ec.l10n.localize('Contact support')}</a></#if></#if><#if siteInfo.authenticated && (siteInfo.mounts || []).some(m => m.app == 'sales')><a href="${passBases.sales}/CustomerQuotes">My quotes</a><a href="${passBases.sales}/CustomerOrders">My orders</a></#if><#if siteInfo.authenticated && (siteInfo.mounts || []).some(m => m.app == 'billing')><a href="${passBases.billing}/Invoices">Invoices</a></#if><#if siteInfo.authenticated && (siteInfo.mounts || []).some(m => m.app == 'supplier')><a href="${passBases.supplier}/SupplierHome">Supplier documents</a></#if><#if passPublicPage><a href="${passBases.account}/Settings">Account</a><#elseif siteInfo.authenticated><a href="${passBases.account}/Home">${ec.l10n.localize('My account')}</a><#else><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath || '')}">Sign in</a></#if></nav></header><main id="main" tabindex="-1">
<#else><a href="#main" class="skip">${ec.l10n.localize('Skip to discussion')}</a><header><strong>${siteInfo.site.name}</strong><nav aria-label="Community">
<a href="${passBases.forum}">Topics</a><a href="${passBases.forum}/Categories">Categories</a><a href="${passBases.forum}/Tags">Tags</a><a href="${passBases.forum}/Search">Search</a><a href="${passBases.forum}/Guidelines">Guidelines</a>
<#if siteInfo.authenticated><a href="${passBases.forum}/Compose">${ec.l10n.localize('New topic')}</a><a href="${passBases.forum}/Drafts">Drafts</a><a href="${passBases.forum}/Bookmarks">Bookmarks</a><a href="${passBases.forum}/Messages">Messages</a><a href="${passBases.account}/Notifications">Notifications</a><a href="${passBases.account}/Settings">Account</a><#else><a href="${passBases.account}/Login">Sign in</a><#if siteInfo.site.registrationMode == 'open'><a href="${passBases.account}/Register">Register</a></#if></#if>
<#if siteInfo.capabilities.canModerateSite><a href="${passBases.forum}/Moderation/ReviewQueue">Review</a><a href="${passBases.forum}/Moderation/Log">${ec.l10n.localize('Moderation log')}</a><a href="${passBases.forum}/Reports/Activity">Activity</a></#if>
<#if siteInfo.capabilities.canManageSite><a href="${passBases.sites}/SiteDetail">Site settings</a><a href="${passBases.forum}/Settings/Categories">${ec.l10n.localize('Manage categories')}</a><a href="${passBases.forum}/Settings/Members">Members</a><a href="${passBases.forum}/Settings/Policies">Policies</a><a href="${passBases.forum}/Settings/Mail">Mail</a><a href="${passBases.forum}/Settings/Operations">Operations</a><a href="${passBases.forum}/Settings/Import">Import</a></#if><a href="${passBases.forum}/feed">RSS</a></nav></header><main id="main" tabindex="-1"></#if>
