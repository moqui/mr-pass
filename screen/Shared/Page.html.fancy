<h1>${view.title}</h1>
<#if view.avatarHref><img src="${view.avatarHref}" alt="Profile image" width="128" height="128"></#if>
<#if ec.web.parameters.saved><p role="status">Your change was saved.</p></#if>
<#if screenName == 'Search'><form method="get"><label>Search topics <input name="query" value="${ec.web.parameters.query || ''}" maxlength="200"></label><button>Search</button></form></#if>
<#if screenName == 'Tags'><form method="get"><label>Find tags <input name="query" value="${ec.web.parameters.query || ''}" maxlength="40"></label><button>Find</button></form></#if>
<#if screenName == 'Topics' && ec.web.parameters.tag><p>Tagged <strong>${ec.web.parameters.tag}</strong> · <a href="${passBases.forum}">All topics</a></p></#if>
<#if view.backHref><p><a href="${view.backHref}">Back to the post</a></p></#if>
<#if view.diffHtml><section aria-label="Changes between revisions" class="card">${raw(view.diffHtml)}</section></#if>
<#if view.topic?.tags?.length><p>Tags: <#list view.topic.tags as tag><a href="${passBases.forum}?tag=${encodeURIComponent(tag)}">${tag}</a> </#list></p></#if>
<#if view.needsLogin><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath)}">Sign in to continue</a></p></#if>
<#if view.notes><#list view.notes as note><article><p>Staff note · ${note.createdAt}</p><p>${note.noteText}</p></article></#list></#if>
<#if view.category?.capabilities.canModerate><p><a href="${passBases.forum}/Moderation/ReviewQueue?contactListId=${view.category.contactListId}">Review category submissions</a> · <a href="${passBases.forum}/Settings/Members?contactListId=${view.category.contactListId}">Manage category members</a></p></#if>
<#if view.body><article>${raw(view.body)}</article></#if>
<#if view.details.length><dl class="card"><#list view.details as item><dt>${item[0]}</dt><dd>${item[1]}</dd></#list></dl></#if>
<#if screenName == 'Notifications'><nav aria-label="Notification views"><a href="?view=all">All</a> · <a href="?view=unread">Unread</a></nav></#if>
<#if view.outcomes?.length><section class="card" aria-label="Moderation outcomes"><h2>Moderation outcomes</h2><#list view.outcomes as outcome><p>${outcome.title} · ${outcome.decisionReason || 'Removed by moderators'}<#if outcome.appealState> · appeal ${outcome.appealState}<#else> · <a href="?reviewId=${encodeURIComponent(outcome.reviewId)}#PassNotificationsAppealReview">Appeal</a></#if></p></#list></section></#if>
<#if view.topic?.timers?.length><p>Scheduled: <#list view.topic.timers as timer>${timer.action} at ${timer.dueAt} </#list></p></#if>
<#if view.topic?.slowIntervalSeconds><p>Slow mode: one reply every ${view.topic.slowIntervalSeconds} seconds per member.</p></#if>
<#if view.activityTitle><h2>${view.activityTitle}</h2></#if>
<#if screenName == 'Topics'><nav aria-label="Topic views"><a href="${passBases.forum}?view=latest">Latest</a><#if siteInfo.authenticated><a href="${passBases.forum}?view=new">New</a><a href="${passBases.forum}?view=unread">Unread</a></#if><a href="${passBases.forum}?view=top">Top</a><a href="${passBases.forum}/Tags">Tags</a><a href="${passBases.forum}?solved=Y">Solved</a><a href="${passBases.forum}?solved=N">Unsolved</a></nav><#if ec.web.parameters.view == 'top'><nav aria-label="Top period"><a href="?view=top&amp;period=day">Today</a><a href="?view=top&amp;period=week">This week</a><a href="?view=top&amp;period=month">This month</a><a href="?view=top&amp;period=year">This year</a><a href="?view=top&amp;period=all">All time</a></nav></#if></#if>
<#if view.stream><div id="public-root" style="display:none"></div><div id="pass-ssr-posts"></#if>
<#list view.rows as row><article>
<#if view.stream><h2 class="post-meta">${row.author.displayName || row.author.handle || 'Community member'} · ${row.dateText || row.entryDate}</h2><#elseif row.href><h2><a href="${row.href}">${row.label}</a></h2><#elseif row.label><h2>${row.label}</h2></#if>
<#if view.stream><#if row.accepted><p class="accepted"><strong>Accepted answer</strong></p></#if><#if row.wiki><p>Wiki post: eligible members may improve it</p></#if><p><a href="${passBases.forum}/p/${row.postId}">Link to this post</a><#if row.capabilities.canEdit> · <a href="${passBases.forum}/Compose?postId=${row.postId}">Edit post</a></#if><#if row.hasHistory> · <a href="${passBases.forum}/Topics/PostHistory?postId=${encodeURIComponent(row.postId)}">History</a></#if><#if view.canFlag> · <a href="?postId=${encodeURIComponent(row.postId)}#PassTopicDetailFlagPost">Report</a></#if><#if view.signedIn> · <a href="?postId=${encodeURIComponent(row.postId)}#PassTopicDetailStoreBookmark">Bookmark</a></#if><#if view.canAccept && !row.accepted && row.postId != row.rootCommEventId && row.visibility == 'approved'> · <a href="?postId=${encodeURIComponent(row.postId)}#PassTopicDetailAcceptAnswer">Accept answer</a></#if><#if row.capabilities.canDelete> · <a href="?postId=${encodeURIComponent(row.postId)}&amp;expectedRevision=${row.revision}#PassTopicDetailDeletePost">Delete</a></#if></p><div id="post-${row.postId}">${raw(row.body)}</div><#list row.attachments as attachment><a href="${publicPath}/download?attachmentId=${attachment.attachmentId}">${attachment.filename}</a></#list>
<#if row.poll><section class="poll" id="poll-${row.poll.pollId}" aria-label="Poll"><h3>${row.poll.question}</h3><#if row.poll.canVote><form method="post" action="${publicPath}/save"><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="formAction" value="votePoll"><input type="hidden" name="operationId" value="${ec.user.randomString(32)}"><input type="hidden" name="pollId" value="${row.poll.pollId}"><fieldset><legend>Choose up to ${row.poll.maxChoices}</legend><#list row.poll.options as option><label><input type="${row.poll.maxChoices > 1 ? 'checkbox' : 'radio'}" name="optionIds" value="${option.optionId}"<#if row.poll.myChoices.includes(option.optionId)> checked</#if>> ${option.label}</label></#list></fieldset><button>Vote</button></form></#if><#if row.poll.voterCount != null><ul><#list row.poll.options as option><li>${option.label}: ${option.voteCount} <#if option.voters?.length>(${option.voters.join(', ')})</#if></li></#list></ul><p>${row.poll.voterCount} ${row.poll.voterCount == 1 ? 'voter' : 'voters'}<#if row.poll.closed> · closed</#if></p><#else><p>Results appear after you vote<#if row.poll.closesAt> or when the poll closes</#if>.</p></#if></section></#if>
<#if row.reactions && Object.keys(row.reactions).length || row.capabilities.canReact><div class="reactions" aria-label="Reactions"><#list ['like','thanks','insightful','agree','laugh'] as key><#if row.capabilities.canReact><form method="post" action="${publicPath}/save" style="display:inline;padding:0;margin:0 .3rem 0 0"><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="formAction" value="setReaction"><input type="hidden" name="postId" value="${row.postId}"><input type="hidden" name="reactionKey" value="${key}"><input type="hidden" name="active" value="${row.myReactions.includes(key) ? 'false' : 'true'}"><button aria-pressed="${row.myReactions.includes(key) ? 'true' : 'false'}">${key} ${row.reactions[key] || 0}</button></form><#elseif row.reactions[key]><span>${key} ${row.reactions[key]} </span></#if></#list></div></#if><#else><#if row.sanctionId><p>${row.kind} · revision ${row.revision} · ${row.reason}</p></#if><#if row.unreadCount><p>${row.unreadCount} unread</p></#if><#if row.partyId><p>Member: ${row.partyId} · ${row.role || row.roleTypeId || 'member'} · revision ${row.revision}</p></#if><#if row.state><p>${row.state}</p></#if><#if row.snippet><p>${row.snippet}</p></#if><#if row.visiblePostCount><p>${row.visiblePostCount} ${Number(row.visiblePostCount) == 1 ? 'post' : 'posts'}<#if row.solved> · solved</#if></p></#if><#if row.tags?.length><p>Tags: ${row.tags.join(', ')}</p></#if><#if row.topicCount != null><p>${row.topicCount} ${row.topicCount == 1 ? 'topic' : 'topics'}</p></#if><#if row.note><p>${row.note}</p></#if><#if row.action><p><a href="${row.action.href}">${row.action.label}</a></p></#if></#if>
</article></#list><#if view.stream></div></#if>
<#if view.read && !view.rows.length && !view.details.length && !view.body><p>No items to display.</p></#if>
<#if view.next><a href="${publicPath}${view.nextHref}">Next page</a></#if>
<#if view.stream && siteInfo.authenticated && view.canReply><a href="${passBases.forum}/Compose?rootCommEventId=${ec.web.parameters.rootCommEventId}">Reply</a></#if>
