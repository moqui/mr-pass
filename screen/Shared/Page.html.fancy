<h1>${view.title}</h1>
<#if view.avatarHref><img src="${view.avatarHref}" alt="Profile image" width="128" height="128"></#if>
<#if ec.web.parameters.saved><p role="status">Your change was saved.</p></#if>
<#if screenName == 'Search'><form method="get"><label>Search topics <input name="query" value="${ec.web.parameters.query || ''}" maxlength="200"></label><#if siteInfo.authenticated><label><input type="checkbox" name="scope" value="private"<#if ec.web.parameters.scope == 'private'> checked</#if>> Search my private messages instead</label></#if><button>Search</button></form></#if>
<#if view.participantsText><p>Participants: ${view.participantsText}</p></#if>
<#if view.messageHref><p><a href="${view.messageHref}">Send a private message</a></p></#if>
<#if screenName == 'Conversations'><nav aria-label="Message views"><a href="?view=inbox">Inbox</a> · <a href="?view=archived">Archived</a></nav></#if>
<#if view.context?.length><section class="card" aria-label="Reported conversation context"><h2>Context shown for this report</h2><#list view.context as item><article><p>Post ${item.ordinal}</p>${raw(item.body)}</article></#list></section></#if>
<#if screenName == 'Tags'><form method="get"><label>Find tags <input name="query" value="${ec.web.parameters.query || ''}" maxlength="40"></label><button>Find</button></form></#if>
<#if screenName == 'Topics' && ec.web.parameters.tag><p>Tagged <strong>${ec.web.parameters.tag}</strong> · <a href="${passBases.forum}">All topics</a></p></#if>
<#if view.backHref><p><a href="${view.backHref}">Back to the post</a></p></#if>
<#if view.diffHtml><section aria-label="Changes between revisions" class="card">${raw(view.diffHtml)}</section></#if>
<#if view.topic?.tags?.length><p>Tags: <#list view.topic.tags as tag><a href="${passBases.forum}?tag=${encodeURIComponent(tag)}">${tag}</a> </#list></p></#if>
<#if view.needsLogin><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath)}">Sign in to continue</a></p></#if>
<#if view.notes><#list view.notes as note><article><p>Staff note · ${note.createdAt}</p><p>${note.noteText}</p></article></#list></#if>
<#if view.category?.capabilities.canModerate><p><a href="${passBases.forum}/Moderation/ReviewQueue?contactListId=${view.category.contactListId}">Review category submissions</a> · <a href="${passBases.forum}/Settings/Members?contactListId=${view.category.contactListId}">Manage category members</a></p></#if>
<#if view.body><article>${raw(view.body)}</article></#if>
<#if view.details.length><dl class="card"><#list view.details as item><dt>${item[0]}</dt><dd>${item[1]}</dd></#list></dl></#if>
<#if screenName == 'Notifications'><nav aria-label="Notification views"><a href="?view=all">All</a> · <a href="?view=unread">Unread</a></nav></#if>
<#if view.links?.length><section class="card" aria-label="Related"><h2>Related</h2><#list view.links as link><p>${link.sourceType == 'case' ? 'Support case' : link.sourceType == 'product' ? 'Product' : 'Article'}: ${link.title || link.sourceId}<#if link.published == false> · not public</#if><#if link.statusId> · ${link.statusId}</#if><#if link.sourceType == 'case'> · <a href="?requestId=${encodeURIComponent(link.sourceId)}#PassTopicDetailPreviewCaseReply">Reply from this case</a></#if><#if view.forms.some(form => form.op == 'detachDiscussion') && link.sourceType != 'case'> · <a href="?linkId=${encodeURIComponent(link.linkId)}#PassTopicDetailDetachDiscussion">Detach</a></#if></p></#list></section></#if>
<#if view.grants?.length><section class="card" aria-label="Access grants"><h2>Access grants</h2><#list view.grants as grant><p>${grant.handle || 'Member'} · ${grant.targetType == 'site' ? 'whole site' : 'category ' + grant.targetId} · ${grant.sourceType || 'manual'} · ${grant.active ? 'active' : 'inactive'}<#if grant.thruDate> · until ${grant.thruDate}</#if><#if grant.reason> · ${grant.reason}</#if><#if (grant.sourceType || 'manual') == 'manual' && grant.active> · <a href="?grantId=${encodeURIComponent(grant.grantId)}&amp;expectedRevision=${grant.revision}<#if ec.web.parameters.contactListId>&amp;contactListId=${encodeURIComponent(ec.web.parameters.contactListId)}</#if>#PassMembersEndAccessGrant">End</a></#if></p></#list></section></#if>
<#if view.bindings?.length><section class="card" aria-label="Subscription resources"><h2>Subscription resources</h2><#list view.bindings as binding><p>${binding.description || binding.subscriptionResourceId} · ${binding.targetType == 'site' ? 'whole site' : 'category ' + binding.targetId}</p></#list></section></#if>
<#if view.entitlements?.length || view.subscriptionUrl><section class="card" aria-label="Access and subscriptions"><h2>Access and subscriptions</h2><#list view.entitlements as entitlement><p>${entitlement.name} · ${entitlement.sourceType == 'subscription' ? 'subscription' : 'granted by staff'} · ${entitlement.active ? 'active' : 'ended'}<#if entitlement.thruDate> · until ${entitlement.thruDate}</#if></p></#list><#if view.subscriptionUrl><p><a href="${view.subscriptionUrl}">Manage your subscription</a></p></#if></section></#if>
<#if view.dataRequests?.length><section class="card" aria-label="Data requests"><h2>Data requests</h2><#list view.dataRequests as request><p>${request.kind}<#if !request.mine> · ${request.handle || 'member'}</#if> · ${request.state}<#if request.reason> · ${request.reason}</#if><#if request.decisionReason> · ${request.decisionReason}</#if><#if !request.mine && request.kind == 'erasure' && request.state == 'requested'> · <a href="?requestId=${encodeURIComponent(request.requestId)}&amp;expectedRevision=${request.revision}#PassOperationsDecideDataRequest">Decide</a></#if></p></#list></section></#if>
<#if view.exports?.length><section class="card" aria-label="Downloads"><h2>Downloads</h2><#list view.exports as file><p><a href="${publicPath}/downloadExport?exportId=${encodeURIComponent(file.exportId)}">${file.filename}</a> · ${file.kind} · until ${file.expiresAt} · SHA-256 ${file.checksum}</p></#list></section></#if>
<#if view.activity><section class="card" aria-label="Activity filters"><form method="get"><label>Category <input name="contactListId" value="${ec.web.parameters.contactListId || ''}"></label><label>From <input type="datetime-local" name="fromDate" value="${ec.web.parameters.fromDate || ''}"></label><label>Until <input type="datetime-local" name="thruDate" value="${ec.web.parameters.thruDate || ''}"></label><label>Interval <select name="interval"><option value="week"<#if ec.web.parameters.interval != 'day'> selected</#if>>Week</option><option value="day"<#if ec.web.parameters.interval == 'day'> selected</#if>>Day</option></select></label><button>Show</button></form></section>
<section class="card" aria-label="Participation"><h2>Participation</h2><table><tr><th scope="row">Topics</th><td>${view.activity.participation.topics}</td></tr><tr><th scope="row">Posts</th><td>${view.activity.participation.posts}</td></tr><tr><th scope="row">Contributors</th><td>${view.activity.participation.contributors}</td></tr></table></section>
<section class="card" aria-label="Moderation"><h2>Moderation</h2><table><tr><th scope="row">Review items opened</th><td>${view.activity.moderation.reviewsOpened}</td></tr><tr><th scope="row">Waiting now</th><td>${view.activity.moderation.pendingNow}</td></tr><tr><th scope="row">Oldest waiting (hours)</th><td>${view.activity.moderation.oldestPendingHours ?? 'none'}</td></tr><tr><th scope="row">Staff actions</th><td>${view.activity.moderation.staffActions}</td></tr></table></section>
<#if view.activity.privateConversations><section class="card" aria-label="Private conversations"><h2>Private conversations</h2><p>Posts: ${view.activity.privateConversations.posts}</p></section></#if>
<#if view.activity.delivery><section class="card" aria-label="Delivery"><h2>Delivery</h2><table><#list Object.entries(view.activity.delivery.byState) as entry><tr><th scope="row">${entry[0]}</th><td>${entry[1]}</td></tr></#list><tr><th scope="row">Total</th><td>${view.activity.delivery.total}</td></tr></table></section></#if>
<#if view.activity.capacity><section class="card" aria-label="Capacity"><h2>Capacity</h2><p>Attachments: ${view.activity.capacity.attachments} · Outbox waiting: ${view.activity.capacity.outboxPending} · Failed operation runs in the period: ${view.activity.failedRuns}</p></section></#if>
<section class="card" aria-label="By period"><h2>By ${view.activity.period.interval}</h2><table><tr><th scope="col">Starting</th><th scope="col">Topics</th><th scope="col">Posts</th></tr><#list view.activity.buckets as bucket><tr><td>${new Date(bucket.start).toISOString().slice(0, 10)}</td><td>${bucket.topics}</td><td>${bucket.posts}</td></tr></#list></table></section>
<#if view.activity.incompletePeriod || view.activity.notes.length><section class="card" aria-label="Notes"><#if view.activity.incompletePeriod><p>The period has not ended; its last interval is incomplete.</p></#if><#list view.activity.notes as note><p>${note}</p></#list></section></#if></#if>
<#if view.routes?.length><section class="card" aria-label="Inbound routes"><h2>Inbound routes</h2><#list view.routes as route><p>${route.address} · ${route.contactListId ? 'new topics and replies' : 'replies only'} · ${route.enabled == 'Y' ? 'enabled' : 'disabled'} · <a href="?routeId=${encodeURIComponent(route.routeId)}&amp;address=${encodeURIComponent(route.address)}&amp;expectedRevision=${route.revision}#PassMailStoreRoute">Edit</a> · <a href="?routeId=${encodeURIComponent(route.routeId)}#PassMailTestRoute">Test</a></p></#list></section></#if>
<#if view.receipts?.length><section class="card" aria-label="Inbound messages"><h2>Inbound messages</h2><#list view.receipts as receipt><p>${receipt.result} · ${receipt.sender}<#if receipt.reason> · ${receipt.reason}</#if><#if receipt.result == 'failed'> · <a href="?receiptId=${encodeURIComponent(receipt.receiptId)}#PassMailRetryInbound">Retry</a></#if></p></#list></section></#if>
<#if view.outcomes?.length><section class="card" aria-label="Moderation outcomes"><h2>Moderation outcomes</h2><#list view.outcomes as outcome><p>${outcome.title} · ${outcome.decisionReason || 'Removed by moderators'}<#if outcome.appealState> · appeal ${outcome.appealState}<#else> · <a href="?reviewId=${encodeURIComponent(outcome.reviewId)}#PassNotificationsAppealReview">Appeal</a></#if></p></#list></section></#if>
<#if view.topic?.timers?.length><p>Scheduled: <#list view.topic.timers as timer>${timer.action} at ${timer.dueAt} </#list></p></#if>
<#if view.topic?.slowIntervalSeconds><p>Slow mode: one reply every ${view.topic.slowIntervalSeconds} seconds per member.</p></#if>
<#if view.activityTitle><h2>${view.activityTitle}</h2></#if>
<#if screenName == 'Topics'><nav aria-label="Topic views"><a href="${passBases.forum}?view=latest">Latest</a><#if siteInfo.authenticated><a href="${passBases.forum}?view=new">New</a><a href="${passBases.forum}?view=unread">Unread</a></#if><a href="${passBases.forum}?view=top">Top</a><a href="${passBases.forum}/Tags">Tags</a><a href="${passBases.forum}?solved=Y">Solved</a><a href="${passBases.forum}?solved=N">Unsolved</a></nav><#if ec.web.parameters.view == 'top'><nav aria-label="Top period"><a href="?view=top&amp;period=day">Today</a><a href="?view=top&amp;period=week">This week</a><a href="?view=top&amp;period=month">This month</a><a href="?view=top&amp;period=year">This year</a><a href="?view=top&amp;period=all">All time</a></nav></#if></#if>
<#if view.stream><div id="public-root" style="display:none"></div><div id="pass-ssr-posts"></#if>
<#list view.rows as row><article>
<#if view.stream><h2 class="post-meta">${row.author.displayName || row.author.handle || 'Community member'} · ${row.dateText || row.entryDate}</h2><#elseif row.href><h2><a href="${row.href}">${row.label}</a></h2><#elseif row.label><h2>${row.label}</h2></#if>
<#if view.stream><#if row.accepted><p class="accepted"><strong>Accepted answer</strong></p></#if><#if row.wiki><p>Wiki post: eligible members may improve it</p></#if><p><a href="${passBases.forum}/p/${row.postId}">Link to this post</a><#if row.capabilities.canEdit> · <a href="${passBases.forum}/Compose?postId=${row.postId}">Edit post</a></#if><#if row.hasHistory> · <a href="${passBases.forum}/Topics/PostHistory?postId=${encodeURIComponent(row.postId)}">History</a></#if><#if view.canFlag> · <a href="?postId=${encodeURIComponent(row.postId)}#PassTopicDetailFlagPost">Report</a></#if><#if view.signedIn> · <a href="?postId=${encodeURIComponent(row.postId)}#PassTopicDetailStoreBookmark">Bookmark</a></#if><#if view.canAccept && !row.accepted && row.postId != row.rootCommEventId && row.visibility == 'approved'> · <a href="?postId=${encodeURIComponent(row.postId)}#PassTopicDetailAcceptAnswer">Accept answer</a></#if><#if row.capabilities.canDelete> · <a href="?postId=${encodeURIComponent(row.postId)}&amp;expectedRevision=${row.revision}#PassTopicDetailDeletePost">Delete</a></#if></p><div id="post-${row.postId}">${raw(row.body)}</div><#list row.attachments as attachment><a href="${publicPath}/download?attachmentId=${attachment.attachmentId}">${attachment.filename}</a></#list>
<#if row.poll><section class="poll" id="poll-${row.poll.pollId}" aria-label="Poll"><h3>${row.poll.question}</h3><#if row.poll.canVote><form method="post" action="${publicPath}/save"><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="formAction" value="votePoll"><input type="hidden" name="operationId" value="${ec.user.randomString(32)}"><input type="hidden" name="pollId" value="${row.poll.pollId}"><fieldset><legend>Choose up to ${row.poll.maxChoices}</legend><#list row.poll.options as option><label><input type="${row.poll.maxChoices > 1 ? 'checkbox' : 'radio'}" name="optionIds" value="${option.optionId}"<#if row.poll.myChoices.includes(option.optionId)> checked</#if>> ${option.label}</label></#list></fieldset><button>Vote</button></form></#if><#if row.poll.voterCount != null><ul><#list row.poll.options as option><li>${option.label}: ${option.voteCount} <#if option.voters?.length>(${option.voters.join(', ')})</#if></li></#list></ul><p>${row.poll.voterCount} ${row.poll.voterCount == 1 ? 'voter' : 'voters'}<#if row.poll.closed> · closed</#if></p><#else><p>Results appear after you vote<#if row.poll.closesAt> or when the poll closes</#if>.</p></#if></section></#if>
<#if row.reactions && Object.keys(row.reactions).length || row.capabilities.canReact><div class="reactions" aria-label="Reactions"><#list ['like','thanks','insightful','agree','laugh'] as key><#if row.capabilities.canReact><form method="post" action="${publicPath}/save" style="display:inline;padding:0;margin:0 .3rem 0 0"><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="formAction" value="setReaction"><input type="hidden" name="postId" value="${row.postId}"><input type="hidden" name="reactionKey" value="${key}"><input type="hidden" name="active" value="${row.myReactions.includes(key) ? 'false' : 'true'}"><button aria-pressed="${row.myReactions.includes(key) ? 'true' : 'false'}">${key} ${row.reactions[key] || 0}</button></form><#elseif row.reactions[key]><span>${key} ${row.reactions[key]} </span></#if></#list></div></#if><#else><#if row.sanctionId><p>${row.kind} · revision ${row.revision} · ${row.reason}</p></#if><#if row.unreadCount><p>${row.unreadCount} unread</p></#if><#if row.partyId><p>Member: ${row.partyId} · ${row.role || row.roleTypeId || 'member'} · revision ${row.revision}</p></#if><#if row.state><p>${row.state}</p></#if><#if row.snippet><p>${row.snippet}</p></#if><#if row.visiblePostCount><p>${row.visiblePostCount} ${Number(row.visiblePostCount) == 1 ? 'post' : 'posts'}<#if row.solved> · solved</#if></p></#if><#if row.tags?.length><p>Tags: ${row.tags.join(', ')}</p></#if><#if row.topicCount != null><p>${row.topicCount} ${row.topicCount == 1 ? 'topic' : 'topics'}</p></#if><#if row.note><p>${row.note}</p></#if><#if row.action><p><a href="${row.action.href}">${row.action.label}</a></p></#if></#if>
</article></#list><#if view.stream></div></#if>
<#if view.read && !view.rows.length && !view.details.length && !view.body && !view.activity><p>No items to display.</p></#if>
<#if view.next><a href="${publicPath}${view.nextHref}">Next page</a></#if>
<#if view.stream && siteInfo.authenticated && view.canReply><a href="${passBases.forum}/Compose?rootCommEventId=${ec.web.parameters.rootCommEventId}">Reply</a></#if>
