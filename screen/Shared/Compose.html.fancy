<#if !siteInfo.authenticated><h1>${ec.l10n.localize('Write a topic or reply')}</h1><p><a href="${passBases.account}/Login">${ec.l10n.localize('Sign in to write')}</a></p><#else>
<#assign composeConfig = {sessionToken:ec.web.sessionToken,locale:siteInfo.site.locale || 'en',timeZone:siteInfo.site.timeZone || 'UTC',quasar:{dark:'auto'},quasarLang:'enUS',qvt:{build:'runtime',handles:['static-template','bundled-qvue']},messages:ec.resource.script('component://webroot/script/IslandMessages.js').islandMessages(['component://mr-pass/screen/Forum/Compose.qvue']),route:{name:'forum-compose',basePath:publicPath,title:'Compose',renderModes:['qvue']},context:{},labels:{loading:'Loading composer',notFound:'The composer could not load. Your saved draft is retained.'}}>
<script type="application/json" id="moqui-public-config">${raw(JSON.stringify(composeConfig).split('<').join('\\u003c'))}</script><div id="public-root" style="display:none"></div>
<link rel="stylesheet" href="/libs/quasar/quasar.prod.css"><link rel="stylesheet" href="/libs/material-icons/material-icons.css"><link rel="stylesheet" href="/libs/material-symbols/outlined.css"><link rel="stylesheet" href="/css/WebrootVue.qvt.css"><script src="/libs/vue/vue.runtime.global.prod.js"></script><script src="/libs/quasar/quasar.umd.prod.js"></script><script src="/libs/quasar/lang/en-US.umd.prod.js"></script><script src="/libs/quasar/icon-set/material-symbols-outlined.umd.prod.js"></script><script src="/js/MoquiLib.js"></script><script src="/js/MoquiL10n.js"></script><script src="/js/WebrootVue.qvt.render.js"></script><script src="/js/WebrootVue.qvt.js"></script><script src="/js/WebrootPublic.qvt.js"></script>
<noscript><h1>Compose</h1><p>${ec.l10n.localize('JavaScript is required to compose. Public reading works without JavaScript.')}</p></noscript>
</#if>
