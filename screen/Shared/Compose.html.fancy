<#if !siteInfo.authenticated><h1>Write a topic or reply</h1><p><a href="${passBases.account}/Login">Sign in to write</a></p><#else>
<#assign composeConfig = {sessionToken:ec.web.sessionToken,locale:siteInfo.site.locale || 'en',timeZone:siteInfo.site.timeZone || 'UTC',quasar:{dark:'auto'},quasarLang:'enUS',qvt:{build:'compiler',handles:['merged-fragment','static-template']},route:{name:'forum-compose',basePath:publicPath,title:'Compose',renderModes:['qvue']},context:{},labels:{loading:'Loading composer',notFound:'The composer could not load. Your saved draft is retained.'}}>
<script type="application/json" id="moqui-public-config">${raw(JSON.stringify(composeConfig).split('<').join('\\u003c'))}</script><div id="public-root" style="display:none"></div>
