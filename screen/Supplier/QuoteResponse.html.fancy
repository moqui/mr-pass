<#if failure><h1>${ec.l10n.localize("Request for quotation")}</h1><p role="alert" class="error">${failure.message}</p><#if failure.kind == 'AuthenticationRequired'><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath)}">${ec.l10n.localize("Sign in")}</a></p></#if>
<#else><#assign q = view.quote><h1><#if q.requestId>${ec.resource.expand("Request for quotation ${q.requestId}", "", {q: q})}<#else>${ec.resource.expand("Quote ${q.orderId}", "", {q: q})}</#if></h1>
<#if quoteError><p role="alert" class="error">${quoteError}</p></#if><#if quoteSaved><p role="status">${quoteSaved}</p></#if>
<section class="card" id="PublishedQuoteRequest" aria-label="${ec.l10n.localize("Request")}"><p><strong>${q.buyerName}</strong> ${ec.resource.expand("asks ${q.supplierName} for a quote", "", {q: q})}<#if q.title>: ${q.title}</#if></p>
<dl><#if q.revisionText><dt>${ec.l10n.localize("Revision")}</dt><dd>${q.revisionText}</dd></#if><#if q.dueText><dt>${ec.l10n.localize("Respond by")}</dt><dd>${q.dueText}<#if q.late> <strong class="error">${ec.l10n.localize("(late)")}</strong></#if></dd></#if><dt>${ec.l10n.localize("Currency")}</dt><dd>${q.currencyUomId}</dd><dt>${ec.l10n.localize("Status")}</dt><dd>${q.statusText}</dd></dl>
<#if q.specification><h3>${ec.l10n.localize("Specification")}</h3><p class="wrap">${q.specification}</p></#if>
<div class="table-wrap"><table class="lines"><caption>${ec.l10n.localize("Items")}</caption><thead><tr><th scope="col">${ec.l10n.localize("Line")}</th><th scope="col">${ec.l10n.localize("Item")}</th><th scope="col">${ec.l10n.localize("Qty")}</th><th scope="col">${ec.l10n.localize("Needed by")}</th><th scope="col">${ec.l10n.localize("Your price")}</th></tr></thead><tbody><#list view.lines as line><tr><td>${line.orderItemSeqId}</td><td>${line.productText}<#if line.description><br><small>${line.description}</small></#if></td><td>${line.quantityText} ${line.unitText}</td><td>${line.requiredText || ''}</td><td>${line.unitAmountText || ''}</td></tr></#list></tbody></table></div></section>
<#if view.receipt><section class="card" id="SubmitResponse" aria-live="polite"><h2>${ec.l10n.localize("Quote received")}</h2><dl><dt>${ec.l10n.localize("Sent")}</dt><dd>${view.receipt.submittedText}<#if view.receipt.late> ${ec.l10n.localize("(after the response date)")}</#if></dd><#if view.receipt.revisionText><dt>${ec.l10n.localize("For revision")}</dt><dd>${view.receipt.revisionText}</dd></#if><#if view.receipt.reference><dt>${ec.l10n.localize("Your reference")}</dt><dd>${view.receipt.reference}</dd></#if><#if view.receipt.totalText><dt>${ec.l10n.localize("Total")}</dt><dd>${view.receipt.totalText}</dd></#if><dt>${ec.l10n.localize("Status")}</dt><dd>${view.receipt.stateText}</dd></dl><p><small>${ec.l10n.localize("The buyer reviews your quote; sending it does not award the order.")}</small></p></section></#if>
<#if view.capabilities.canSubmit><form method="post" enctype="multipart/form-data" id="SupplierOffer" class="card" action="${publicPath}/respond"><h2>${ec.l10n.localize("Your quote")}</h2>
<input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><#if token><input type="hidden" name="token" value="${token}"><#else><input type="hidden" name="orderId" value="${q.orderId}"></#if>
<input type="hidden" name="operationId" value="${submitOperationId}"><input type="hidden" name="rfqRevision" value="${q.revision}"><input type="hidden" name="lineSeqs" value="${view.lines.map(l => l.orderItemSeqId).join(',')}">
<#if view.draft><p><small>${ec.resource.expand("Draft saved ${view.draft.savedText}.", "", {view: view})}</small></p></#if>
<label>${ec.l10n.localize("Your quote reference")} <input name="otherPartyOrderId" maxlength="60" value="${q.otherPartyOrderId || ''}"></label>
<label>${ec.l10n.localize("Valid through")} <input type="date" name="validThruDate" value="${q.validThruDate || ''}"></label>
<label>${ec.l10n.localize("Delivery by")} <input type="date" name="estimatedDeliveryDate" value="${q.estimatedDeliveryDate || ''}"></label>
<#list view.lines as line><fieldset class="card" id="OfferLine${line.orderItemSeqId}"><legend>${ec.resource.expand("Line ${line.orderItemSeqId}: ${line.productText} · ${line.quantityText} ${line.unitText}", "", {line: line})}</legend>
<label>${ec.resource.expand("Unit price (${q.currencyUomId})", "", {q: q})} <input name="price_${line.orderItemSeqId}" inputmode="decimal" size="12" value="${line.unitAmount || ''}"></label>
<label>${ec.l10n.localize("Promised date")} <input type="date" name="promised_${line.orderItemSeqId}" value="${line.promisedDate || ''}"></label>
<label>${ec.l10n.localize("Your item code")} <input name="code_${line.orderItemSeqId}" maxlength="60" size="16" value="${line.otherPartyProductId || ''}"></label></fieldset></#list>
<label>${ec.l10n.localize("Note to the buyer")} <textarea name="note" rows="3" maxlength="1000">${q.note || ''}</textarea></label>
<label>${ec.l10n.localize("Quote file (PDF, PNG or JPEG, at most 10 MB; optional)")} <input type="file" name="file" accept="application/pdf,image/png,image/jpeg"></label>
<label><input type="checkbox" name="confirm" value="true"> ${ec.l10n.localize("This is our quote, on the terms above")}<#if q.validThruDate>${ec.l10n.localize(" and valid through the date given")}</#if></label>
<p><button name="formAction" value="save">${ec.l10n.localize("Save draft")}</button> <button name="formAction" value="send">${ec.l10n.localize("Send quote")}</button></p>
<p><small>${ec.l10n.localize("A draft is yours alone; the buyer sees the quote once you send it, and reviews it before any order.")}</small></p></form></#if></#if>
