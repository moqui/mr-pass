<#if failure><h1>${ec.l10n.localize("Purchase order")}</h1><p role="alert" class="error">${failure.message}</p><#if failure.kind == 'AuthenticationRequired'><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath)}">${ec.l10n.localize("Sign in")}</a></p></#if>
<#elseif view.superseded><h1>${ec.resource.expand("Purchase order ${view.superseded.orderId}", "", {view: view})}</h1><p role="alert" class="error" id="SupersededRevision">${view.superseded.message}</p><p><a href="${billPath}">${ec.l10n.localize("Send a bill for this order")}</a></p>
<#else><#assign o = view.order><h1>${ec.resource.expand("Purchase order ${o.orderId}", "", {o: o})}</h1>
<#if orderError><p role="alert" class="error">${orderError}</p></#if><#if orderNotice><p role="status">${orderNotice}</p></#if>
<section class="card" id="PublishedPurchaseOrder" aria-label="${ec.l10n.localize("Order")}"><p><strong>${o.buyerName}</strong> ${ec.resource.expand("orders from ${o.supplierName}", "", {o: o})}<#if o.orderName>: ${o.orderName}</#if></p>
<dl><dt>${ec.l10n.localize("Revision")}</dt><dd>${o.revisionText}</dd><#if o.placedText><dt>${ec.l10n.localize("Placed")}</dt><dd>${o.placedText}</dd></#if><#if o.deliveryText><dt>${ec.l10n.localize("Delivery by")}</dt><dd>${o.deliveryText}</dd></#if><#if o.paymentTermText><dt>${ec.l10n.localize("Payment terms")}</dt><dd>${o.paymentTermText}</dd></#if><#if o.incotermText><dt>${ec.l10n.localize("Incoterm")}</dt><dd>${o.incotermText}</dd></#if><#if o.shipToName || o.shipToAddress><dt>${o.dropShip ? ec.l10n.localize("Ship to the customer") : ec.l10n.localize("Deliver to")}</dt><dd class="wrap">${o.shipToName || ''}<#if o.shipToAddress><br>${o.shipToAddress}</#if></dd></#if><#if o.totalText><dt>${ec.l10n.localize("Order total")}</dt><dd>${o.totalText}</dd></#if><dt>${ec.l10n.localize("Status")}</dt><dd>${o.statusText}</dd></dl>
<div class="table-wrap"><table class="lines"><caption>${ec.l10n.localize("Lines")}</caption><thead><tr><th scope="col">${ec.l10n.localize("Line")}</th><th scope="col">${ec.l10n.localize("Item")}</th><th scope="col">${ec.l10n.localize("Qty")}</th><th scope="col">${ec.l10n.localize("Price")}</th><th scope="col">${ec.l10n.localize("Amount")}</th><th scope="col">${ec.l10n.localize("Needed by")}</th><th scope="col">${ec.l10n.localize("Promised")}</th></tr></thead><tbody><#list view.lines as line><tr><td>${line.orderItemSeqId}</td><td>${line.productText}<#if line.otherPartyProductId><br><small>${ec.resource.expand("Your code ${line.otherPartyProductId}", "", {line: line})}</small></#if><#if line.description><br><small>${line.description}</small></#if></td><td>${line.quantityText} ${line.unitText}<#if line.deliveredText><br><small>${ec.resource.expand("${line.deliveredText} delivered", "", {line: line})}</small></#if></td><td>${line.priceText || ''}</td><td>${line.totalText || ''}</td><td>${line.requiredText || ''}</td><td>${line.promisedDate || ''}<#if line.promisedQuantity> (${line.promisedQuantity})</#if></td></tr></#list></tbody></table></div>
<p><a href="${billPath}">${ec.l10n.localize("Send a bill for this order")}</a></p></section>
<#if view.subcontractList.length><section class="card" id="SubcontractWork" aria-label="${ec.l10n.localize("Outside processing")}"><h2>${ec.l10n.localize("Your work on our components")}</h2><#list view.subcontractList as work><article><p><strong>${ec.resource.expand("Line ${work.orderItemSeqId}", "", {work: work})}</strong>: ${work.operationText}<#if work.dueText>${ec.resource.expand(" · due ${work.dueText}", "", {work: work})}</#if></p><#if work.custodyText><p>${ec.resource.expand("Our components held at ${work.custodyText}", "", {work: work})}<#if !work.componentList.length>: ${ec.l10n.localize("none yet")}</#if></p></#if><#if work.componentList.length><ul><#list work.componentList as component><li>${component.productText}: ${component.quantityText}</li></#list></ul></#if></article></#list><p><small>${ec.l10n.localize("The components stay ours while you hold them.")}</small></p></section></#if>
<#if view.acknowledgement><section class="card" id="AcknowledgementReceipt" aria-live="polite"><h2>${ec.l10n.localize("Acknowledged")}</h2><dl><dt>${ec.l10n.localize("Response")}</dt><dd>${view.acknowledgement.outcomeText}</dd><dt>${ec.l10n.localize("When")}</dt><dd>${view.acknowledgement.dateText}</dd><#if view.acknowledgement.reference><dt>${ec.l10n.localize("Your reference")}</dt><dd>${view.acknowledgement.reference}</dd></#if><#if view.acknowledgement.note><dt>${ec.l10n.localize("Your note")}</dt><dd class="wrap">${view.acknowledgement.note}</dd></#if><#if view.receipt><dt>${ec.l10n.localize("Status")}</dt><dd>${view.receipt.stateText}</dd></#if></dl><p><small>${ec.l10n.localize("The buyer reviews any change; acknowledging changes no quantity or price.")}</small></p></section></#if>
<#if view.capabilities.canAcknowledge><form method="post" enctype="multipart/form-data" id="AcknowledgeOrder" class="card" action="${publicPath}/acknowledge"><h2>${ec.resource.expand("Acknowledge ${o.revisionText}", "", {o: o})}</h2>
<input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><#if token><input type="hidden" name="token" value="${token}"><#else><input type="hidden" name="orderId" value="${o.orderId}"></#if>
<input type="hidden" name="operationId" value="${ackOperationId}"><input type="hidden" name="orderRevision" value="${o.revision}"><input type="hidden" name="lineSeqs" value="${view.lines.map(l => l.orderItemSeqId).join(',')}">
<fieldset><legend>${ec.l10n.localize("Your response")}</legend><label><input type="radio" name="outcome" value="accept" checked> ${ec.l10n.localize("Accept as ordered")}</label><label><input type="radio" name="outcome" value="change"> ${ec.l10n.localize("Accept with changes (give the reason)")}</label><label><input type="radio" name="outcome" value="reject"> ${ec.l10n.localize("Reject (give the reason)")}</label></fieldset>
<label>${ec.l10n.localize("Your order reference")} <input name="otherPartyOrderId" maxlength="60"></label>
<#list view.lines as line><fieldset class="card" id="AckLine${line.orderItemSeqId}"><legend>${ec.resource.expand("Line ${line.orderItemSeqId}: ${line.productText} · ${line.quantityText} ${line.unitText}", "", {line: line})}<#if line.requiredText>${ec.resource.expand(", needed by ${line.requiredText}", "", {line: line})}</#if></legend>
<label>${ec.l10n.localize("Promised date")} <input type="date" name="promised_${line.orderItemSeqId}" value="${line.promisedDate || ''}"></label>
<label>${ec.l10n.localize("Promised quantity")} <input name="promisedQty_${line.orderItemSeqId}" inputmode="decimal" size="10" value="${line.promisedQuantity || ''}"></label></fieldset></#list>
<label>${ec.l10n.localize("Reason or note")} <textarea name="note" rows="3" maxlength="1000"></textarea></label>
<label>${ec.l10n.localize("Confirmation file (PDF, PNG or JPEG, at most 10 MB; optional)")} <input type="file" name="file" accept="application/pdf,image/png,image/jpeg"></label>
<p><button>${ec.l10n.localize("Send acknowledgement")}</button></p></form></#if>
<#if view.capabilities.canReportDelivery><form method="post" id="ReportDelivery" class="card" action="${publicPath}/deliver"><h2>${ec.l10n.localize("Report a delivery to the customer")}</h2>
<input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><#if token><input type="hidden" name="token" value="${token}"><#else><input type="hidden" name="orderId" value="${o.orderId}"></#if>
<input type="hidden" name="operationId" value="${deliverOperationId}"><input type="hidden" name="lineSeqs" value="${view.lines.map(l => l.orderItemSeqId).join(',')}">
<#list view.lines as line><label>${ec.resource.expand("Line ${line.orderItemSeqId} shipped (of ${line.quantityText})", "", {line: line})} <input name="shipped_${line.orderItemSeqId}" inputmode="decimal" size="10"></label></#list>
<label>${ec.l10n.localize("Tracking code")} <input name="trackingCode" maxlength="60"></label><label>${ec.l10n.localize("Shipped on")} <input type="date" name="shippedDate"></label><label>${ec.l10n.localize("Note")} <textarea name="note" rows="2" maxlength="500"></textarea></label>
<p><button>${ec.l10n.localize("Report a delivery")}</button></p><p><small>${ec.l10n.localize("The buyer confirms the delivery; this report ships nothing.")}</small></p></form></#if>
<#if view.deliveryReports.length><section class="card" aria-label="${ec.l10n.localize("Deliveries reported")}"><h2>${ec.l10n.localize("Deliveries reported")}</h2><#list view.deliveryReports as report><p>${ec.resource.expand("${report.submittedText} · shipped ${report.shippedText}", "", {report: report})}<#if report.trackingCode>${ec.resource.expand(" · tracking ${report.trackingCode}", "", {report: report})}</#if> · ${report.stateText}</p></#list></section></#if></#if>
