<#if failure><h1>${ec.l10n.localize("Supplier documents")}</h1><p role="alert" class="error">${failure.message}</p><#if failure.kind == 'AuthenticationRequired'><p>${ec.l10n.localize("Open the link the buyer sent you, or")} <a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath)}">${ec.l10n.localize("sign in")}</a> ${ec.l10n.localize("with the account you were invited to.")}</p></#if>
<#else><h1>${ec.l10n.localize("Supplier documents")}</h1>
<#if view.supplierName><p>${view.supplierName}</p></#if>
<section class="card" id="SupplierDocuments" aria-label="${ec.l10n.localize("Documents")}"><h2>${ec.l10n.localize("Requests and orders")}</h2>
<#if view.documentList.length><ul class="docs"><#list view.documentList as doc><li><p><strong>${doc.reference}</strong><#if doc.title> · ${doc.title}</#if></p><p><#if doc.dueText>${doc.kind == 'quote' ? ec.resource.expand("${doc.stateText} · respond by ${doc.dueText}", "", {doc: doc}) : ec.resource.expand("${doc.stateText} · delivery by ${doc.dueText}", "", {doc: doc})}<#else>${doc.stateText}</#if></p><p><a href="${passBases.supplier}${doc.path}">${doc.actionText}</a></p></li></#list></ul>
<#else><p>${ec.resource.expand("Nothing to answer from ${view.contact.organizationName} right now.", "", {view: view})}</p></#if></section>
<#if view.billList.length><section class="card" aria-label="${ec.l10n.localize("Bills sent")}"><h2>${ec.l10n.localize("Bills sent")}</h2><ul class="docs"><#list view.billList as bill><li><a href="${passBases.supplier}${bill.path}">${bill.referenceNumber}</a> ${ec.resource.expand("· order ${bill.orderId} · ${bill.receivedDateText}", "", {bill: bill})}</li></#list></ul></section></#if>
<section class="card" id="SupplierContact" aria-label="${ec.l10n.localize("Contact")}"><h2>${ec.l10n.localize("Contact")}</h2><dl><dt>${ec.l10n.localize("Buyer")}</dt><dd>${view.contact.organizationName}</dd><#if view.contact.emailAddress><dt>${ec.l10n.localize("Email")}</dt><dd class="wrap"><a href="mailto:${view.contact.emailAddress}">${view.contact.emailAddress}</a></dd></#if><#if view.contact.expiresText><dt>${ec.l10n.localize("This link works until")}</dt><dd>${view.contact.expiresText}</dd></#if></dl></section></#if>
