<#if failure><h1>${ec.l10n.localize("Bill upload")}</h1><p role="alert" class="error">${failure.message}</p><#if failure.kind == 'AuthenticationRequired'><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath)}">${ec.l10n.localize("Sign in")}</a></p></#if>
<#else><h1>${ec.resource.expand("Bill for order ${view.order.orderId}", "", {view: view})}</h1>
<#if billError><p role="alert" class="error">${billError}</p></#if>
<section class="card" aria-label="${ec.l10n.localize("Order")}"><dl><#if view.order.orderName><dt>${ec.l10n.localize("Order")}</dt><dd>${view.order.orderName}</dd></#if><#if view.order.placedDateText><dt>${ec.l10n.localize("Placed")}</dt><dd>${view.order.placedDateText}</dd></#if><#if view.order.totalText><dt>${ec.l10n.localize("Order total")}</dt><dd>${view.order.totalText}</dd></#if></dl></section>
<#if view.submission><section class="card" id="SubmissionReceipt" aria-live="polite"><h2>${ec.l10n.localize("Bill received")}</h2><dl><dt>${ec.l10n.localize("Your bill number")}</dt><dd>${view.submission.referenceNumber}</dd><dt>${ec.l10n.localize("Received")}</dt><dd>${view.submission.receivedDateText}</dd><dt>${ec.l10n.localize("Our reference")}</dt><dd>${view.submission.billReference}</dd><dt>${ec.l10n.localize("File")}</dt><dd class="wrap">${view.submission.filename}</dd><dt>${ec.l10n.localize("Status")}</dt><dd>${view.submission.stateText}</dd></dl><p><a href="?<#if token>token=${encodeURIComponent(token)}<#else>orderId=${encodeURIComponent(view.order.orderId)}</#if>">${ec.l10n.localize("Send another bill for this order")}</a></p></section></#if>
<#if view.submissionList.length && !view.submission><section class="card" aria-label="${ec.l10n.localize("Bills sent")}"><h2>${ec.l10n.localize("Bills sent for this order")}</h2><#list view.submissionList as row><p>${row.referenceNumber} · ${row.receivedDateText} · ${row.stateText}</p></#list></section></#if></#if>
