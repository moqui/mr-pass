<div class="smithy-head"><nav aria-label="Breadcrumb" class="smithy-crumbs smithy-quiet"><#list smithyGroup.crumbs as crumb><#if crumb_index><span aria-hidden="true">/</span></#if><#if crumb.href><a href="${crumb.href}">${crumb.label}</a><#else><strong>${crumb.label}</strong></#if></#list></nav>
<div class="smithy-title"><h1 class="wrap"><strong>${smithyGroup.group.name}</strong></h1><#if smithyGroup.visibility> <small class="smithy-chip">${smithyGroup.visibility}</small></#if><#if smithyGroup.hidden> <small class="smithy-chip" id="SmithyHidden">Hidden</small></#if></div>
<#if smithyGroup.hidden><p role="status" class="card" id="SmithyHiddenNote">${ec.l10n.localize("A moderator hid this group: only its owners and the site's moderators see it, and everyone else gets Not Found.")}</p></#if>
<nav aria-label="${ec.l10n.localize("Group sections")}" class="card smithy-tabs"><#list smithyGroup.tabs as tab><a href="${tab.href}"<#if tab.current> aria-current="page"</#if>>${tab.label}<#if tab.count != null> <small>${tab.count}</small></#if></a></#list></nav></div>
<#if smithyGroup.flash.notice><p role="status" class="card" id="SmithyNotice">${smithyGroup.flash.notice}</p></#if>
<#if smithyGroup.reportHref && smithyGroup.section != 'moderation'><p class="smithy-quiet"><a href="${smithyGroup.reportHref}" id="SmithyReport">${ec.l10n.localize("Report this group")}</a><#if smithyGroup.hideHref> · <a href="${smithyGroup.hideHref}" id="SmithyHideLink">${smithyGroup.hidden ? 'Show it again' : 'Hide it'}</a></#if></p></#if>
