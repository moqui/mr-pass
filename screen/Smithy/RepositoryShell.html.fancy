<div class="smithy-head"><div class="smithy-title"><h1 class="wrap"><#list smithyRepository.crumbs as crumb><#if crumb_index> / </#if><#if crumb_index + 1 != smithyRepository.crumbs.length><a href="${crumb.href}">${crumb.label}</a><#else><strong>${crumb.label}</strong></#if></#list></h1><#if smithyRepository.visibility> <small class="smithy-chip">${smithyRepository.visibility}</small></#if><#if smithyRepository.repository.archived> <small class="smithy-chip">Archived</small></#if><#if smithyRepository.repository.mirror> <small class="smithy-chip">Mirror</small></#if><#if smithyRepository.hidden> <small class="smithy-chip" id="SmithyHidden">Hidden</small></#if>
<div class="smithy-stats" id="SmithyForks"><a href="${smithyRepository.forksHref}"><b>${smithyRepository.forkCount}</b> ${smithyRepository.forkCount == 1 ? 'fork' : 'forks'}</a><#if smithyRepository.forkHref><a class="smithy-btn" href="${smithyRepository.forkHref}">${ec.l10n.localize("Fork")}</a></#if></div></div>
<#if smithyRepository.hidden><p role="status" class="card" id="SmithyHiddenNote">${ec.l10n.localize("A moderator hid this repository: only its owners and the site's moderators see it, on its pages and in git, and everyone else gets Not Found.")}</p></#if>
<#if smithyRepository.repository.description><p class="smithy-desc">${smithyRepository.repository.description}</p></#if>
<#if smithyRepository.forkOf><p id="SmithyForkOf" class="smithy-quiet">${ec.l10n.localize("Forked from")} <a href="${smithyRepository.forkOf.href}">${smithyRepository.forkOf.path}</a></p></#if>
<nav aria-label="${ec.l10n.localize("Repository sections")}" class="card smithy-tabs"><#list smithyRepository.tabs as tab><a href="${tab.href}"<#if tab.current> aria-current="page"</#if>>${tab.label}<#if tab.count != null> <small>${tab.count}</small></#if></a></#list></nav></div>
<#if smithyRepository.flash.notice><p role="status" class="card" id="SmithyNotice">${smithyRepository.flash.notice}</p></#if>
<#if smithyRepository.reportHref && smithyRepository.section != 'moderation' && smithyRepository.section != '' && smithyRepository.section != 'tree'><p class="smithy-quiet"><a href="${smithyRepository.reportHref}" id="SmithyReport">${ec.l10n.localize("Report this repository")}</a><#if smithyRepository.hideHref> · <a href="${smithyRepository.hideHref}" id="SmithyHideLink">${smithyRepository.hidden ? 'Show it again' : 'Hide it'}</a></#if></p></#if>
