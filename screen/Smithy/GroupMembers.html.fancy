<h2>Members</h2>
<section id="SmithyMemberList" aria-label="Members"><#if !view.members.length><p class="card">${ec.l10n.localize("No members to show.")}</p></#if>
<#list view.members as member><article class="card smithy-row"><h3><#if member.href><a href="${member.href}">${member.displayName}</a><#else>${member.displayName}</#if><#if member.handle> <small>@${member.handle}</small></#if></h3><p><strong>${member.role}</strong><#if member.fromPath> ${ec.resource.expand("· from ${member.fromPath}", "", {member: member})}</#if><#if member.since> ${ec.resource.expand("· since ${member.since}", "", {member: member})}</#if><#if member.until> ${ec.resource.expand("· until ${member.until}", "", {member: member})}</#if></p>${raw(member.formsHtml || '')}</article></#list></section>
<#if view.moreHref><p><a href="${view.moreHref}">${ec.l10n.localize("More members")}</a></p></#if>
${raw(memberForms.addHtml)}${raw(memberForms.leaveHtml)}
