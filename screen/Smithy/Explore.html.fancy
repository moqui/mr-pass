<h1>${smithyHome ? siteInfo.site.name : 'Explore'}</h1>
<#if exploreView.notice><p role="status" class="card" id="SmithyNotice">${exploreView.notice}</p></#if>
<form method="get" action="${exploreView.action}" class="card" role="search" id="SmithyExploreFind"><label>Search <input type="search" name="q" value="${exploreView.q}" maxlength="100"></label>
<label>Show <select name="kind"><option value="all"<#if exploreView.kind == 'all'> selected</#if>>Everything</option><option value="groups"<#if exploreView.kind == 'groups'> selected</#if>>Groups</option><option value="repositories"<#if exploreView.kind == 'repositories'> selected</#if>>Repositories</option><option value="components"<#if exploreView.kind == 'components'> selected</#if>>Components</option></select></label><button>Find</button></form>
<#if exploreView.groups><section id="SmithyExploreGroups" aria-label="Groups"><h2>Groups</h2><#if !exploreView.groups.length><p class="card">${ec.l10n.localize("No groups to show.")}</p></#if>
${raw(ec.resource.template('component://mr-pass/screen/Smithy/GroupRows.html.fancy', {rows: exploreView.groups}))}
<#if exploreView.moreGroupsHref><p><a href="${exploreView.moreGroupsHref}">${ec.l10n.localize("More groups")}</a></p></#if></section></#if>
<#if exploreView.repositories><section id="SmithyExploreRepositories" aria-label="Repositories"><h2>Repositories</h2><#if !exploreView.repositories.length><p class="card">${ec.l10n.localize("No repositories to show.")}</p></#if>
${raw(ec.resource.template('component://mr-pass/screen/Smithy/RepositoryRows.html.fancy', {rows: exploreView.repositories}))}
<#if exploreView.moreRepositoriesHref><p><a href="${exploreView.moreRepositoriesHref}">${ec.l10n.localize("More repositories")}</a></p></#if></section></#if>
<#if exploreView.components><section id="SmithyExploreComponents" aria-label="Components"><h2>Components</h2><#if !exploreView.components.length><p class="card">${ec.l10n.localize("No components to show. A repository whose root has a component.xml is listed here.")}</p></#if>
<#list exploreView.components as row><article class="card smithy-row"><h3 class="wrap"><a href="${row.href}">${row.name}</a><#if row.version> <small>${row.version}</small></#if></h3><#if row.description><p>${row.description}</p></#if><p><small><a href="${row.href}">${row.path}</a><#if row.dependsOn.length> ${ec.resource.expand("· depends on ${row.dependsOn.join(', ')}", "", {row: row})}</#if><#if row.releaseHref> ${ec.l10n.localize("· latest release")} <a href="${row.releaseHref}">${row.latestTag}</a></#if></small></p></article></#list>
<#if exploreView.moreComponentsHref><p><a href="${exploreView.moreComponentsHref}">${ec.l10n.localize("More components")}</a></p></#if></section></#if>
