<#if view.empty><section class="card" id="SmithyEmpty"><h2>${ec.l10n.localize("This repository is empty")}</h2>
<#if smithyRepository.capabilities.canPush><p>${ec.l10n.localize("Push a first commit to it. Over HTTPS git asks for your username and an access token; over SSH it uses a key of yours. Both are on")} <a href="${passBases.account}/GitAccess">${ec.l10n.localize("Git access")}</a>.</p>
<#elseif smithyRepository.capabilities.signedIn><p><#if (smithyRepository.capabilities.confirmed == false)>${ec.l10n.localize("Nothing has been pushed to it yet. A Developer of the repository pushes the first commit, from an account with a confirmed email address.")}<#else>${ec.l10n.localize("Nothing has been pushed to it yet. A Developer of the repository pushes the first commit.")}</#if></p>
<#else><p>${ec.l10n.localize("Nothing has been pushed to it yet.")}</p></#if>
<#list smithyRepository.pushUrls as clone><h3>${clone.label}</h3><p>${ec.l10n.localize("From a new directory:")}</p><pre class="smithy-code">git init -b ${smithyRepository.repository.defaultBranch || 'main'}
git add .
git commit -m "First commit"
git remote add origin ${clone.url}
git push -u origin ${smithyRepository.repository.defaultBranch || 'main'}</pre><p>${ec.l10n.localize("From a repository you have:")}</p><pre class="smithy-code">git remote add origin ${clone.url}
git push -u origin --all
git push origin --tags</pre></#list></section>
<#if smithyRepository.reportHref><p class="smithy-quiet"><a href="${smithyRepository.reportHref}" id="SmithyReport">${ec.l10n.localize("Report this repository")}</a><#if smithyRepository.hideHref> · <a href="${smithyRepository.hideHref}" id="SmithyHideLink">${smithyRepository.hidden ? 'Show it again' : 'Hide it'}</a></#if></p></#if>
<#else><div class="smithy-files"><div>
<div class="smithy-toolbar">
<details class="smithy-menu" id="SmithyRefMenu"><summary class="smithy-btn" aria-label="${ec.resource.expand("Branch or tag: ${view.ref}", "")}">${view.ref}</summary><div class="smithy-pop"><span class="h">Branches</span><#list view.choices.branches as name><a href="${view.pickerAction}?ref=${encodeURIComponent(name)}&amp;path=${encodeURIComponent(view.path)}"<#if name == view.ref> aria-current="true"</#if>>${name == view.ref ? '✓ ' : ''}${name}</a></#list><#if view.choices.tags.length><span class="h">Tags</span><#list view.choices.tags as name><a href="${view.pickerAction}?ref=${encodeURIComponent(name)}&amp;path=${encodeURIComponent(view.path)}"<#if name == view.ref && !view.choices.branches.includes(name)> aria-current="true"</#if>>${name == view.ref && !view.choices.branches.includes(name) ? '✓ ' : ''}${name}</a></#list></#if>
<form method="get" action="${view.pickerAction}" id="SmithyRefPicker"><label>Branch or tag <select name="ref"><#if !view.choices.branches.includes(view.ref) && !view.choices.tags.includes(view.ref)><option value="${view.ref}" selected>${view.ref}</option></#if><optgroup label="Branches"><#list view.choices.branches as name><option value="${name}"<#if name == view.ref> selected</#if>>${name}</option></#list></optgroup><#if view.choices.tags.length><optgroup label="Tags"><#list view.choices.tags as name><option value="${name}"<#if name == view.ref && !view.choices.branches.includes(name)> selected</#if>>${name}</option></#list></optgroup></#if></select></label><input type="hidden" name="path" value="${view.path}"><button>Go</button></form></div></details>
<nav aria-label="Path" class="smithy-crumbs"><#list view.crumbs as crumb><#if crumb_index><span aria-hidden="true">/</span></#if><#if crumb.href><a href="${crumb.href}">${crumb.label}</a><#else><strong>${crumb.label}</strong></#if></#list></nav>
<span class="smithy-sp"></span>
<#if smithyRepository.cloneUrls.length><div class="smithy-clone" id="SmithyClone" role="group" aria-label="${ec.l10n.localize("Clone address")}"><#list smithyRepository.cloneUrls as clone><input type="radio" name="smithyClone" class="r${clone_index}" id="SmithyClone_${clone_index}"<#if !clone_index> checked</#if>><label for="SmithyClone_${clone_index}">${clone.label}</label></#list><#list smithyRepository.cloneUrls as clone><input type="text" class="u u${clone_index}" readonly value="${clone.url}" aria-label="${ec.resource.expand("${clone.label} clone address", "", {clone: clone})}"></#list></div></#if>
<details class="smithy-menu"><summary class="smithy-btn" aria-label="${ec.l10n.localize("More actions")}">⋯</summary><div class="smithy-pop r"><#if view.newFileHref><div id="SmithyFileActions"><a href="${view.newFileHref}">New file</a><a href="${view.uploadHref}">${ec.l10n.localize("Upload a file")}</a></div></#if><a href="${view.historyHref}">History</a><#if view.archives><div id="SmithyArchives"><span class="h">${ec.resource.expand("Download ${view.ref}", "")}</span><#list view.archives as archive><a href="${archive.href}" rel="nofollow">${archive.label}</a></#list></div></#if><#if smithyRepository.capabilities.signedIn><span class="h">Push</span><a href="${passBases.account}/GitAccess">${ec.l10n.localize("Git access: SSH keys and tokens")}</a></#if></div></details>
</div>
<div class="smithy-tree"><#if view.lastCommit><div class="smithy-last wrap" id="SmithyLastCommit"><strong>${view.lastCommit.authorName}</strong><a href="${view.lastCommit.href}">${view.lastCommit.summary}</a><span class="m"><a href="${view.lastCommit.href}"><code>${view.lastCommit.shortId}</code></a><#if view.lastCommit.date> · ${view.lastCommit.date}</#if> · <a href="${view.historyHref}">History</a></span></div></#if>
<div class="table-wrap"><table class="lines" id="SmithyTree"><thead><tr><th scope="col">Name</th><th scope="col" class="smithy-wide">Last commit</th><th scope="col" class="smithy-wide">Size</th><th scope="col">Date</th></tr></thead><tbody>
<#if view.parentHref><tr><td colspan="4"><span class="smithy-ic" aria-hidden="true">↰</span><a href="${view.parentHref}" aria-label="${ec.l10n.localize("Parent directory")}">..</a></td></tr></#if>
<#list view.entries as entry><tr><td class="n"><span class="smithy-ic" aria-hidden="true">${entry.directory ? '▸' : entry.submodule ? '⇢' : '◦'}</span><#if entry.href><a href="${entry.href}">${entry.name}<#if entry.directory>/</#if></a><#else>${entry.name} <small>(submodule)</small></#if></td><td class="c smithy-wide"><#if entry.commitHref><a href="${entry.commitHref}">${entry.summary}</a><#else>${entry.summary}</#if></td><td class="s smithy-wide">${entry.size}</td><td class="d">${entry.date}</td></tr></#list>
<#if !view.entries.length><tr><td colspan="4">${ec.l10n.localize("This directory is empty.")}</td></tr></#if></tbody></table></div></div>
<#if view.moreHref><p><a href="${view.moreHref}">${ec.l10n.localize("Show more")}</a></p></#if>
<#if view.readme><article id="SmithyReadme" class="wrap smithy-readme"><h2>${view.readme.path}</h2><div class="b">${raw(view.readme.html)}</div></article></#if>
</div><aside class="smithy-about" aria-label="${ec.l10n.localize("About this repository")}"><h2>About</h2><#if smithyRepository.repository.description><p>${smithyRepository.repository.description}</p></#if>
<dl><#list smithyRepository.tabs as tab><#if tab.count != null><dt>${tab.label}</dt><dd><a href="${tab.href}">${ec.resource.expand("${tab.count} open", "", {tab: tab})}</a></dd><#elseif tab.label == 'Releases'><dt>Releases</dt><dd><a href="${tab.href}">View</a></dd></#if></#list><#if smithyRepository.repository.defaultBranch><dt>Default branch</dt><dd><code>${smithyRepository.repository.defaultBranch}</code></dd></#if><dt>Branches</dt><dd>${view.choices.branches.length}${view.choices.branches.length + view.choices.tags.length == 100 ? '+' : ''}</dd><dt>Tags</dt><dd>${view.choices.tags.length}${view.choices.branches.length + view.choices.tags.length == 100 ? '+' : ''}</dd><dt>Forks</dt><dd><a href="${smithyRepository.forksHref}">${smithyRepository.forkCount}</a></dd></dl>
<#if smithyRepository.reportHref><div class="box smithy-quiet"><a href="${smithyRepository.reportHref}" id="SmithyReport">${ec.l10n.localize("Report this repository")}</a><#if smithyRepository.hideHref> · <a href="${smithyRepository.hideHref}" id="SmithyHideLink">${smithyRepository.hidden ? 'Show it again' : 'Hide it'}</a></#if></div></#if></aside></div></#if>
