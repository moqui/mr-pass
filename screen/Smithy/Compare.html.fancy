<h2>Compare</h2>
<form method="get" action="${view.action}" class="card" id="SmithyCompareForm"><label>Base <input name="from" value="${view.base}" maxlength="250" required></label><label>Compare <input name="to" value="${view.head}" maxlength="250" required></label><button>Compare</button></form>
<p><small>${ec.l10n.localize("A fork's branch is written")} <code>group/repository:branch</code>.<#if view.parent> ${ec.l10n.localize("This repository is a fork:")} <a href="${view.parent.href}" id="SmithyCompareParent">${ec.resource.expand("compare with ${view.parent.path}", "")}</a>.</#if></small></p>
<#if view.failure><p role="alert" class="error">${view.failure}</p></#if>
<#if view.result><p class="card" id="SmithyCompareSummary"><#if view.result.mergeable == true>${ec.resource.expand("${ahead} ahead, ${behind} behind · merges cleanly", "", {ahead: view.result.aheadBy, behind: view.result.behindBy})}<#elseif view.result.mergeable == false><#if (view.result.conflictPaths.length)>${ec.resource.expand("${ahead} ahead, ${behind} behind · conflicts in ${paths}", "", {ahead: view.result.aheadBy, behind: view.result.behindBy, paths: view.result.conflictPaths.join(', ')})}<#else>${ec.resource.expand("${ahead} ahead, ${behind} behind · conflicts", "", {ahead: view.result.aheadBy, behind: view.result.behindBy})}</#if><#else>${ec.resource.expand("${ahead} ahead, ${behind} behind", "", {ahead: view.result.aheadBy, behind: view.result.behindBy})}</#if></p>
<#if view.openHref><p id="SmithyOpenMergeRequest"><a href="${view.openHref}">${ec.l10n.localize("Open a merge request")}</a></p></#if>
<section id="SmithyCompareCommits" aria-label="${ec.l10n.localize("Commits")}"><h2>${ec.l10n.localize("Commits")}</h2><#if !view.result.commits.length><p class="card">${ec.l10n.localize("No commits to show.")}</p></#if><#list view.result.commits as row><article class="card smithy-row"><p class="wrap"><a href="${row.href}">${row.summary || row.shortId}</a></p><p><small>${row.authorName}<#if row.authorHref> <a href="${row.authorHref}">@${row.authorHandle}</a></#if> · ${row.date} · <a href="${row.href}"><code>${row.shortId}</code></a></small></p></article></#list><#if view.result.commitsTruncated><p>${ec.l10n.localize("Only the first commits are listed.")}</p></#if></section></#if>
