<section id="SmithyChanges" aria-label="${ec.l10n.localize("Changed files")}"><div class="smithy-difftools"><h2><#if (changes.files.length == 1)>${ec.resource.expand("${count} file changed", "", {count: changes.files.length})}<#else>${ec.resource.expand("${count} files changed", "", {count: changes.files.length})}</#if> <small>+${changes.insertions} −${changes.deletions}</small></h2><nav aria-label="${ec.l10n.localize("Diff view")}" class="smithy-seg"><a href="${changes.unifiedHref}"<#if !changes.split> aria-current="true"</#if>>Unified</a><a href="${changes.splitHref}"<#if changes.split> aria-current="true"</#if>>Split</a></nav></div>
<#if changes.truncated && !changes.onePath><p class="card">${ec.l10n.localize("This change is large; only part of its diff is shown.")}</p></#if>
<div class="smithy-review"><nav aria-label="Files" class="smithy-filetree"><ul class="card" id="SmithyFileList"><#list changes.files as file><li class="wrap"><a href="${file.href}" title="${file.path}"><span class="st st-${file.status.toLowerCase()}" aria-hidden="true"></span>${file.path}</a> <small><#if file.oldPath>${ec.resource.expand("${file.status} from ${file.oldPath}", "", {file: file})}<#else>${file.status}</#if> +${file.insertions} −${file.deletions}</small></li></#list></ul></nav>
<div class="smithy-filelist"><#if changes.onePath><p><a href="${changes.split ? '?view=split' : '?'}">${ec.l10n.localize("Show every file")}</a></p></#if><#list changes.files as file><#if !changes.onePath || file.path == changes.onePath><section class="card smithy-file" id="${file.anchor}"><details open><summary><h3 class="wrap"><#if file.oldPath>${file.oldPath} → </#if>${file.path} <small>${file.status}</small> ${raw(file.statHtml)}<#if file.viewHref> <a class="smithy-viewfile" href="${file.viewHref}">${ec.l10n.localize("View file")}</a></#if></h3></summary><#if file.diffHtml>${raw(file.diffHtml)}<#elseif file.binary><p>${ec.l10n.localize("Binary file.")}</p><#else><p>${ec.l10n.localize("No text changes to show.")}</p></#if></details></section></#if></#list></div></div></section>
