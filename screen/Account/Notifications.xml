<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" require-authentication="false" default-menu-title="Notifications">
  <transition name="save">
    <actions>
      <script><![CDATA[
        const saved=ec.resource.script('component://mr-pass/screen/Shared/View.js').save('Notifications',resolvedSiteId,ec.web.parameters)
        if(ec.web.parameters.formAction?.startsWith('preview') && ec.web.response){ec.web.response.setContentType('text/html');ec.web.response.write(ec.resource.script('component://mr-pass/screen/Shared/View.js').preview(saved,publicPath.replace(/\/save$/, '')));return}
        if (ec.web.request.getHeader('accept')?.includes('application/json')) ec.web.sendJsonResponse(saved)
        else ec.web.response.sendRedirect(publicPath.replace(/\/save$/, '') + '?saved=true')
    ]]></script>
    </actions>
    <default-response type="none"/>
  </transition>
  <actions>
    <script><![CDATA[
        screenName='Notifications'
        view=ec.resource.script('component://mr-pass/screen/Shared/View.js').load(screenName,siteId,ec.web.parameters,passBases,siteInfo)
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Shared/Page.html.fancy"/>
    </render-mode>
    <section name="PassNotificationSelection" condition="view.rows.length &gt; 0">
      <widgets>
        <render-mode>
          <text type="html"><![CDATA[<form method="post" action="${publicPath}/save"><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">]]></text>
        </render-mode>
        <form-single name="PassNotificationSeen" transition="save" skip-start="true" skip-end="true">
          <field name="formAction">
            <default-field>
              <hidden default-value="markNotifications"/>
            </default-field>
          </field>
          <field name="deliveryIds">
            <default-field title="Notifications">
              <check>
                <list-options list="view.rows.filter(row =&gt; !row.read)" key="deliveryId" text="${title}"/>
              </check>
            </default-field>
          </field>
          <field name="all">
            <default-field title="Mark every unread notification read">
              <check>
                <option key="true" text="All unread"/>
              </check>
            </default-field>
          </field>
          <field name="submitAction">
            <default-field title="Mark read">
              <submit/>
            </default-field>
          </field>
        </form-single>
        <render-mode>
          <text type="html"><![CDATA[</form>]]></text>
        </render-mode>
      </widgets>
    </section>
    <section name="PassNotificationsAppealReviewSection" condition="view.forms.some(form =&gt; form.op === 'appealReview')">
      <widgets>
        <render-mode>
          <text type="html"><![CDATA[<form method="post" id="PassNotificationsAppealReview" action="${publicPath}/save"><h2>Appeal a moderation decision</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">]]></text>
        </render-mode>
        <form-single name="PassNotificationsAppealReview" transition="save" map="Object.assign({},view.formValues['appealReview'] || {},ec.web.parameters)" skip-start="true" skip-end="true">
          <field name="formAction">
            <default-field>
              <hidden default-value="appealReview"/>
            </default-field>
          </field>
          <field name="operationId">
            <default-field>
              <hidden default-value="${ec.user.randomString(32)}"/>
            </default-field>
          </field>
          <field name="rootCommEventId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="contactListId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="token">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="returnTo">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeType">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="reviewId">
            <default-field title="Decision">
              <text-line input-type="text"/>
            </default-field>
          </field>
          <field name="reason">
            <default-field title="Why it should be reconsidered">
              <text-area cols="60" rows="6"/>
            </default-field>
          </field>
          <field name="submitAction">
            <default-field title="Appeal a moderation decision">
              <submit/>
            </default-field>
          </field>
        </form-single>
        <render-mode>
          <text type="html"><![CDATA[</form>]]></text>
        </render-mode>
      </widgets>
    </section>
  </widgets>
</screen>
