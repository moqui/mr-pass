<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" require-authentication="false" default-menu-title="Settings">
  <transition name="downloadExport" method="get" read-only="true">
    <actions>
      <script>ec.resource.script('component://mr-pass/service/pass/Facade.js').downloadExport(resolvedSiteId,ec.web.parameters.exportId)</script>
    </actions>
    <default-response type="none"/>
  </transition>
  <transition name="save">
    <actions>
      <script><![CDATA[
        const saved=ec.resource.script('component://mr-pass/screen/Shared/View.js').save('Settings',resolvedSiteId,ec.web.parameters)
        if(ec.web.parameters.formAction?.startsWith('preview') && ec.web.response){ec.web.response.setContentType('text/html');ec.web.response.write(ec.resource.script('component://mr-pass/screen/Shared/View.js').preview(saved,publicPath.replace(/\/save$/, '')));return}
        if (ec.web.request.getHeader('accept')?.includes('application/json')) ec.web.sendJsonResponse(saved)
        else ec.web.response.sendRedirect(publicPath.replace(/\/save$/, '') + '?saved=true')
    ]]></script>
    </actions>
    <default-response type="none"/>
  </transition>
  <transition name="avatar" method="post">
    <actions>
      <script><![CDATA[
        const invoke=(operation,input)=>ec.service.sync().throwOnError(true).name('pass.Facade.call#Operation').parameters({operation,input:Object.assign({siteId:resolvedSiteId},input)}).call().result
        const handle=invoke('getSiteInfo',{}).profile?.handle
        if(!handle)throw new Error('Save your profile before uploading an avatar')
        const profile=invoke('getProfile',{handle}).profile
        const attachment=invoke('stageAttachment',{purpose:'avatar',file:ec.web.multiPartParameters.file}).attachment
        if(attachment.scanState !== 'clean')throw new Error('Avatar was held in quarantine; choose another image')
        invoke('storeProfile',{handle:profile.handle,displayName:profile.displayName,bio:profile.bio,locale:profile.locale,timeZone:profile.timeZone,discoverability:profile.discoverability,avatarId:attachment.attachmentId,expectedRevision:profile.revision})
        ec.web.response.sendRedirect(publicPath.replace(/\/avatar$/, '')+'?saved=true')
    ]]></script>
    </actions>
    <default-response type="none"/>
  </transition>
