<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" require-authentication="false" default-menu-title="Login">
  <transition name="save">
    <actions>
      <script><![CDATA[
        const saved=ec.resource.script('component://mr-pass/screen/Shared/View.js').save('Login',resolvedSiteId,ec.web.parameters)
        if(saved.externalRedirect)return
        if(saved.redirectUrl){ec.web.response.sendRedirect(saved.redirectUrl);return}
        if(saved.secondFactorRequired){ec.web.response.sendRedirect(passBases.account+'/SecondFactor');return}
        if(saved.authenticated || saved.state==='active'){const destination=ec.web.sessionAttributes.passReturnTo || passBases.forum || '/';ec.web.sessionAttributes.remove('passReturnTo');ec.web.response.sendRedirect(destination);return}
        if(ec.web.parameters.formAction?.startsWith('preview') && ec.web.response){ec.web.response.setContentType('text/html');ec.web.response.write(ec.resource.script('component://mr-pass/screen/Shared/View.js').preview(saved,publicPath.replace(/\/save$/, '')));return}
        if (ec.web.request.getHeader('accept')?.includes('application/json')) ec.web.sendJsonResponse(saved)
        else ec.web.response.sendRedirect(publicPath.replace(/\/save$/, '') + '?saved=true')
    ]]></script>
    </actions>
    <default-response type="none"/>
  </transition>
  <actions>
    <script><![CDATA[
        screenName='Login'
        view=ec.resource.script('component://mr-pass/screen/Shared/View.js').load(screenName,siteId,ec.web.parameters,passBases,siteInfo)
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Shared/Page.html.fancy"/>
    </render-mode>
    <section name="PassLoginStartSessionSection" condition="view.forms.some(form =&gt; form.op === 'startSession')">
      <widgets>
        <render-mode>
          <text type="html"><![CDATA[<form method="post" id="PassLoginStartSession" action="${publicPath}/save"><h2>Sign in</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">]]></text>
        </render-mode>
        <form-single name="PassLoginStartSession" transition="save" map="Object.assign({},view.formValues['startSession'] || {},ec.web.parameters)" skip-start="true" skip-end="true">
          <field name="formAction">
            <default-field>
              <hidden default-value="startSession"/>
            </default-field>
          </field>
          <field name="operationId">
            <default-field>
              <hidden default-value="${ec.user.randomString(32)}"/>
            </default-field>
          </field>
          <field name="rootCommEventId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="contactListId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="reviewId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="token">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="returnTo">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeType">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="username">
            <default-field title="Email or username">
              <text-line input-type="text"/>
            </default-field>
          </field>
          <field name="password" from="''">
            <default-field title="Password">
              <password/>
            </default-field>
          </field>
          <field name="submitAction">
            <default-field title="Sign in">
              <submit/>
            </default-field>
          </field>
        </form-single>
        <render-mode>
          <text type="html"><![CDATA[</form>]]></text>
        </render-mode>
      </widgets>
    </section>
    <section name="PassLoginRequestRecoverySection" condition="view.forms.some(form =&gt; form.op === 'requestRecovery')">
      <widgets>
        <render-mode>
          <text type="html"><![CDATA[<form method="post" id="PassLoginRequestRecovery" action="${publicPath}/save"><h2>Send recovery instructions</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">]]></text>
        </render-mode>
        <form-single name="PassLoginRequestRecovery" transition="save" map="Object.assign({},view.formValues['requestRecovery'] || {},ec.web.parameters)" skip-start="true" skip-end="true">
          <field name="formAction">
            <default-field>
              <hidden default-value="requestRecovery"/>
            </default-field>
          </field>
          <field name="operationId">
            <default-field>
              <hidden default-value="${ec.user.randomString(32)}"/>
            </default-field>
          </field>
          <field name="rootCommEventId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="contactListId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="reviewId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="token">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="returnTo">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeType">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="emailAddress">
            <default-field title="Email">
              <text-line input-type="email"/>
            </default-field>
          </field>
          <field name="submitAction">
            <default-field title="Send recovery instructions">
              <submit/>
            </default-field>
          </field>
        </form-single>
        <render-mode>
          <text type="html"><![CDATA[</form>]]></text>
        </render-mode>
      </widgets>
    </section>
    <section name="PassLoginStartSsoSection" condition="view.forms.some(form =&gt; form.op === 'startSso')">
      <widgets>
        <render-mode>
          <text type="html"><![CDATA[<form method="post" id="PassLoginStartSso" action="${publicPath}/save"><h2>Sign in with your provider</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">]]></text>
        </render-mode>
        <form-single name="PassLoginStartSso" transition="save" map="Object.assign({},view.formValues['startSso'] || {},ec.web.parameters)" skip-start="true" skip-end="true">
          <field name="formAction">
            <default-field>
              <hidden default-value="startSso"/>
            </default-field>
          </field>
          <field name="operationId">
            <default-field>
              <hidden default-value="${ec.user.randomString(32)}"/>
            </default-field>
          </field>
          <field name="rootCommEventId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="contactListId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="reviewId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="token">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="returnTo">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeType">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="authFlowId">
            <default-field title="Provider">
              <drop-down allow-empty="false">
                <list-options list="siteInfo.ssoFlows" key="flowId" text="${flowId}"/>
              </drop-down>
            </default-field>
          </field>
          <field name="submitAction">
            <default-field title="Sign in with your provider">
              <submit/>
            </default-field>
          </field>
        </form-single>
        <render-mode>
          <text type="html"><![CDATA[</form>]]></text>
        </render-mode>
      </widgets>
    </section>
  </widgets>
</screen>
