<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" require-authentication="false" default-menu-title="MemberDetail">
  <transition name="download" method="get" read-only="true">
    <actions>
      <script>ec.resource.script('component://mr-pass/service/pass/Facade.js').download(resolvedSiteId,ec.web.parameters.attachmentId,ec.web.parameters.variant)</script>
    </actions>
    <default-response type="none"/>
  </transition>
  <transition name="save">
    <actions>
      <script><![CDATA[
        const saved=ec.resource.script('component://mr-pass/screen/Shared/View.js').save('MemberDetail',resolvedSiteId,ec.web.parameters)
        if(ec.web.parameters.formAction?.startsWith('preview') && ec.web.response){ec.web.response.setContentType('text/html');ec.web.response.write(ec.resource.script('component://mr-pass/screen/Shared/View.js').preview(saved,publicPath.replace(/\/save$/, '')));return}
        if (ec.web.request.getHeader('accept')?.includes('application/json')) ec.web.sendJsonResponse(saved)
        else ec.web.response.sendRedirect(publicPath.replace(/\/save$/, '') + '?saved=true')
    ]]></script>
    </actions>
    <default-response type="none"/>
  </transition>
  <actions>
    <script><![CDATA[
        screenName='MemberDetail'
        view=ec.resource.script('component://mr-pass/screen/Shared/View.js').load(screenName,siteId,ec.web.parameters,passBases,siteInfo)
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Shared/Page.html.fancy"/>
    </render-mode>
    <section name="PassMemberDetailSetMemberPreferenceSection" condition="view.forms.some(form =&gt; form.op === 'setMemberPreference')">
      <widgets>
        <render-mode>
          <text type="html"><![CDATA[<form method="post" id="PassMemberDetailSetMemberPreference" action="${publicPath}/save"><h2>Mute or block this member</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">]]></text>
        </render-mode>
        <form-single name="PassMemberDetailSetMemberPreference" transition="save" map="Object.assign({},view.formValues['setMemberPreference'] || {},ec.web.parameters)" skip-start="true" skip-end="true">
          <field name="formAction">
            <default-field>
              <hidden default-value="setMemberPreference"/>
            </default-field>
          </field>
          <field name="operationId">
            <default-field>
              <hidden default-value="${ec.user.randomString(32)}"/>
            </default-field>
          </field>
          <field name="rootCommEventId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="contactListId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="reviewId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="token">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="returnTo">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeType">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="scopeId">
            <default-field>
              <hidden/>
            </default-field>
          </field>
          <field name="targetHandle">
            <default-field title="Member">
              <text-line input-type="text"/>
            </default-field>
          </field>
          <field name="preference">
            <default-field title="Preference">
              <drop-down allow-empty="false">
                <option key="none" text="none"/>
                <option key="mute" text="mute"/>
                <option key="block" text="block"/>
              </drop-down>
            </default-field>
          </field>
          <field name="expiresAt">
            <default-field title="Until (optional)">
              <text-line input-type="datetime-local"/>
            </default-field>
          </field>
          <field name="submitAction">
            <default-field title="Mute or block this member">
              <submit/>
            </default-field>
          </field>
        </form-single>
        <render-mode>
          <text type="html"><![CDATA[</form>]]></text>
        </render-mode>
      </widgets>
    </section>
  </widgets>
</screen>
