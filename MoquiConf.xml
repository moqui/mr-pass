<!-- PASS's own conf, loaded on the authority and on a remote frontend alike (IronStone impl-marketing P15, F55, F79): PASS Marketing's
    tracking redirect and pixel, web scripts of mr-pass (not framework files: the framework names no Mantle service). Each declines the
    session, runs as the anonymous request, sets nothing but the visitor key (a Set-Cookie header, where the authority says it may be
    kept and the browser does not ask not to be tracked), reaches the authority only through PASS's facade and transport (in process,
    REST or gRPC) by the two schema operations resolveTrackingLink and recordTrackingEvent, and answers the redirect or the image even
    when recording fails; a destination never comes from the request. docs/Deployment.md "Marketing app: Tracking links". -->
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-moqui-conf.xsd">
    <!-- PASS's settings (docs/Deployment.md), each also an environment name (moqui_conf__pass__backend_url) and the same on
        an authority that runs Mantle without mr-pass, which reads the media, import, scanner and mail ones. The authority:
        backend-url its final https origin (empty: local mode, with Mantle in this runtime; edge: the edge node's link),
        client-id the client registered there and client-secret its secret (in .env, never in a conf file);
        backend-transport rest, grpc or empty for automatic, backend-grpc-url its gRPC listener, backend-web-url its web
        address for the SSO front channel (backend-url when empty), backend-insecure true to send the secret in clear text
        to another host. notification-endpoint is the notification socket's path (empty: none, the page polls). Media and
        imports: media-root and import-dir (storage every cluster member reads), scanner-service and classifier-service
        (the services that scan an upload and classify a post; none: uploads and classification are off), test-scanner
        for the test scanner only, mbox-max-message-bytes (10 MB when empty), import-max-bytes and import-max-entries (what a
        forum import unpacks of an archive, and of its dump, at most: 2 GiB and 200,000 entries). Mail: route-domains (the list domains),
        sender-addresses and mail-template-ids (what the Forum may send from and with). preview-frame-origins are the
        BOSS origins that may frame a theme preview; authority-name is how Operations names the authority. -->
    <pass backend-url="" client-id="" client-secret="" backend-transport="" backend-grpc-url="" backend-web-url=""
            backend-insecure="false" notification-endpoint="/notws" media-root="" import-dir="" scanner-service=""
            classifier-service="" test-scanner="false" mbox-max-message-bytes="" import-max-bytes="2147483648"
            import-max-entries="200000" route-domains="" sender-addresses=""
            mail-template-ids="" preview-frame-origins="" authority-name="local"/>
    <webapp-list>
        <webapp name="webroot">
            <!-- a tracking link: /trk/{siteId}/{publicCode}, with a send's personalized ?token= (redacted from the request log) -->
            <servlet name="PassTrackingRedirect" location="component://mr-pass/script/TrackingRedirect.js">
                <url-pattern>/trk/*</url-pattern>
            </servlet>
            <!-- a send's open pixel: /trk-o/{siteId}?token= -->
            <servlet name="PassTrackingPixel" location="component://mr-pass/script/TrackingPixel.js">
                <url-pattern>/trk-o/*</url-pattern>
            </servlet>
            <!-- Smithy's Forgejo API (plan/design-smithy.md §4.5): on a site whose Smithy is at the root of its host, else the framework's
                 /api/v1 (the filter passes the request on); a filter reserves no path segment -->
            <filter name="SmithyApi" location="component://mr-pass/script/SmithyApi.js">
                <url-pattern>/api/v1/*</url-pattern>
            </filter>
            <!-- per client (on when the per-client web protection is); the authority keeps its own limit per client and code and per
                site, over which a visitor is still redirected and nothing is recorded -->
            <web-protection>
                <rate-limit name="pass-tracking" path="/trk/**" methods="GET,HEAD" requests="60" seconds="60" burst="60"/>
                <rate-limit name="pass-tracking-pixel" path="/trk-o/**" methods="GET,HEAD" requests="120" seconds="60" burst="120"/>
            </web-protection>
            <!-- PASS's bearer path segments (SEC-PSF-03): recorded as :token by the request log, log lines, Visits and
                 telemetry (screen/token_route.rs token-path); the forum's held mail under any mount or Smithy scope, a held
                 report's link, and the theme preview host's page and assets -->
            <token-path pattern="/**/held-mail/{token}"/>
            <token-path pattern="/**/-/held-report/{token}"/>
            <token-path pattern="/preview/{token}"/>
        </webapp>
    </webapp-list>
</moqui-conf>
